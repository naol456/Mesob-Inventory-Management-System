# =============================================================================
# MESOB INVENTORY MANAGEMENT SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
#
# SECURITY WARNING:
# - Copy this file to .env and fill in actual values
# - NEVER commit .env file to version control
# - Use strong, unique passwords for production
# - Rotate credentials regularly
#
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL SETTINGS
# -----------------------------------------------------------------------------

# Deployment environment (production, staging, development)
ENVIRONMENT=production

# System timezone (use timedatectl list-timezones to see options)
TZ=Africa/Addis_Ababa

# Domain name for the application (required for SSL)
DOMAIN=inventory.mesobcenter.et

# Administrator email (for SSL certificate notifications)
ADMIN_EMAIL=admin@mesobcenter.et

# -----------------------------------------------------------------------------
# ODOO CONFIGURATION
# -----------------------------------------------------------------------------

# Odoo version
ODOO_VERSION=19.0

# Odoo master password (used for database management operations)
# CRITICAL: Use a strong password (min 20 characters, random)
# Generate with: openssl rand -base64 32
ODOO_MASTER_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_MIN_20_CHARS

# Default database name
ODOO_DB_NAME=mesob_inventory_production

# Odoo admin username (initial setup)
ODOO_ADMIN_USER=admin

# Odoo admin password (initial setup)
# Generate with: openssl rand -base64 24
ODOO_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Number of Odoo workers (recommended: CPU cores * 2 + 1)
# For 2 CPUs: 5, For 4 CPUs: 9
ODOO_WORKERS=5

# Maximum cron threads
ODOO_MAX_CRON_THREADS=2

# Worker limits
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560

# Database filter (regex for allowed database names)
# Recommended: ^mesob.*$ to only allow databases starting with "mesob"
ODOO_DB_FILTER=^mesob.*$

# List databases? (set to False in production for security)
ODOO_LIST_DB=False

# Proxy mode (required when behind nginx)
ODOO_PROXY_MODE=True

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# PostgreSQL version
POSTGRES_VERSION=16

# Database host (use 'postgres' for docker compose internal network)
POSTGRES_HOST=postgres

# Database port
POSTGRES_PORT=5432

# PostgreSQL superuser (do NOT use in Odoo, only for admin tasks)
POSTGRES_USER=postgres

# PostgreSQL superuser password
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD

# Odoo database user (used by Odoo to connect)
POSTGRES_ODOO_USER=odoo

# Odoo database password
# Generate with: openssl rand -base64 32
POSTGRES_ODOO_PASSWORD=CHANGE_ME_TO_STRONG_ODOO_DB_PASSWORD

# PostgreSQL shared buffers (25% of RAM recommended)
# For 4GB RAM: 1GB, For 8GB RAM: 2GB
POSTGRES_SHARED_BUFFERS=1GB

# PostgreSQL effective cache size (50-75% of RAM)
# For 4GB RAM: 3GB, For 8GB RAM: 6GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB

# PostgreSQL max connections
POSTGRES_MAX_CONNECTIONS=100

# -----------------------------------------------------------------------------
# NGINX CONFIGURATION
# -----------------------------------------------------------------------------

# Nginx version
NGINX_VERSION=alpine

# HTTP port (typically 80, redirects to HTTPS)
NGINX_HTTP_PORT=80

# HTTPS port (typically 443)
NGINX_HTTPS_PORT=443

# Maximum upload size (for file uploads in Odoo)
NGINX_MAX_UPLOAD_SIZE=100M

# Client body timeout (seconds)
NGINX_CLIENT_BODY_TIMEOUT=300

# Proxy timeout (seconds)
NGINX_PROXY_TIMEOUT=300

# Enable rate limiting (requests per second per IP)
NGINX_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# SSL/TLS CONFIGURATION
# -----------------------------------------------------------------------------

# SSL provider (letsencrypt or selfsigned for testing)
SSL_PROVIDER=letsencrypt

# Let's Encrypt staging (set to true for testing, false for production)
LETSENCRYPT_STAGING=false

# SSL certificate renewal email
SSL_EMAIL=${ADMIN_EMAIL}

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# -----------------------------------------------------------------------------

# Backup directory (on host)
BACKUP_DIR=/opt/mesob-inventory/backups

# Backup retention (days)
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# Backup schedule (cron format: minute hour day month weekday)
BACKUP_SCHEDULE=0 2 * * *

# Backup compression level (1-9, 9 = maximum compression)
BACKUP_COMPRESSION=6

# Enable off-site backup (true/false)
OFFSITE_BACKUP_ENABLED=false

# S3 bucket for off-site backup (if enabled)
# S3_BUCKET=s3://mesob-inventory-backups
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# EMAIL/SMTP CONFIGURATION
# -----------------------------------------------------------------------------

# SMTP server for outgoing emails
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP user (email address)
SMTP_USER=noreply@mesobcenter.et

# SMTP password
SMTP_PASSWORD=CHANGE_ME_TO_SMTP_PASSWORD

# SMTP security (STARTTLS or SSL)
SMTP_SECURITY=STARTTLS

# From email address
EMAIL_FROM=Mesob Inventory <noreply@mesobcenter.et>

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------

# Log level (debug, info, warning, error, critical)
# Use 'info' for production, 'debug' only for troubleshooting
LOG_LEVEL=info

# Log retention (days)
LOG_RETENTION_DAYS=30

# Maximum log file size (MB)
LOG_MAX_SIZE=100

# Enable access logs (true/false)
ACCESS_LOGS_ENABLED=true

# -----------------------------------------------------------------------------
# MONITORING CONFIGURATION
# -----------------------------------------------------------------------------

# Enable health checks (true/false)
HEALTH_CHECK_ENABLED=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

# Prometheus metrics (true/false)
PROMETHEUS_ENABLED=false

# Prometheus port
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------

# Enable fail2ban for SSH protection (true/false)
FAIL2BAN_ENABLED=true

# Maximum SSH login attempts before ban
FAIL2BAN_MAX_RETRY=5

# Ban duration (seconds, 3600 = 1 hour)
FAIL2BAN_BAN_TIME=3600

# UFW firewall enabled (true/false)
UFW_ENABLED=true

# Allowed SSH port
SSH_PORT=22

# Allowed SSH IPs (comma-separated, empty = all)
# Example: SSH_ALLOWED_IPS=203.0.113.10,203.0.113.20
SSH_ALLOWED_IPS=

# Enable automatic security updates (true/false)
AUTO_SECURITY_UPDATES=true

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING
# -----------------------------------------------------------------------------

# Enable Redis for session storage (true/false)
REDIS_ENABLED=false

# Redis host
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis password
REDIS_PASSWORD=

# Enable Varnish cache (true/false)
VARNISH_ENABLED=false

# Varnish cache size (MB)
VARNISH_CACHE_SIZE=256

# -----------------------------------------------------------------------------
# DEVELOPMENT/DEBUG SETTINGS (DISABLE IN PRODUCTION)
# -----------------------------------------------------------------------------

# Debug mode (NEVER enable in production)
DEBUG_MODE=false

# Developer mode (NEVER enable in production)
DEV_MODE=

# Test mode (NEVER enable in production)
TEST_ENABLE=false

# Allow database manager (NEVER enable in production without IP restrictions)
ALLOW_DB_MANAGER=false

# -----------------------------------------------------------------------------
# CONTAINER SETTINGS
# -----------------------------------------------------------------------------

# Restart policy (unless-stopped, always, on-failure)
RESTART_POLICY=unless-stopped

# Container timezone
CONTAINER_TZ=${TZ}

# User/Group IDs (for file permissions)
PUID=1000
PGID=1000

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
#
# After editing this file:
# 1. Rename to .env: mv .env.example .env
# 2. Secure permissions: chmod 600 .env
# 3. Review all CHANGE_ME values
# 4. Generate strong passwords for production
# 5. Verify domain DNS is configured
# 6. Run deployment script: ./scripts/deploy.sh
#
# =============================================================================
