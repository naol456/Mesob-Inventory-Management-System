# =============================================================================
# MESOB INVENTORY - LOCAL TESTING ENVIRONMENT
# =============================================================================
#
# This is a LOCAL TESTING configuration for Windows PC.
# DO NOT use this in production!
#
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL SETTINGS
# -----------------------------------------------------------------------------

ENVIRONMENT=local_testing
TZ=Africa/Addis_Ababa
DOMAIN=localhost
ADMIN_EMAIL=admin@localhost

# -----------------------------------------------------------------------------
# ODOO CONFIGURATION
# -----------------------------------------------------------------------------

ODOO_VERSION=19.0

# Master password for database management
# For local testing, using simple password (NEVER in production!)
ODOO_MASTER_PASSWORD=local_test_master_password_123

# Default database name
ODOO_DB_NAME=mesob_inventory_local_test

# Odoo workers (for local testing, use fewer workers)
ODOO_WORKERS=2

# Maximum cron threads
ODOO_MAX_CRON_THREADS=1

# Worker limits (reduced for local testing)
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560

# Database filter
ODOO_DB_FILTER=.*

# List databases (enabled for local testing)
ODOO_LIST_DB=True

# Proxy mode (disabled for local testing)
ODOO_PROXY_MODE=False

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

POSTGRES_VERSION=16

# Database host (docker compose internal network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# PostgreSQL superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_postgres_password_123

# Odoo database user
POSTGRES_ODOO_USER=odoo
POSTGRES_ODOO_PASSWORD=local_odoo_db_password_123

# PostgreSQL tuning (reduced for local testing)
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_MAX_CONNECTIONS=100

# -----------------------------------------------------------------------------
# NGINX CONFIGURATION
# -----------------------------------------------------------------------------

NGINX_VERSION=alpine

# Ports (using standard ports for local testing)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Maximum upload size
NGINX_MAX_UPLOAD_SIZE=100M

# Client body timeout
NGINX_CLIENT_BODY_TIMEOUT=300

# Proxy timeout
NGINX_PROXY_TIMEOUT=300

# Rate limiting
NGINX_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# SSL/TLS CONFIGURATION (DISABLED FOR LOCAL TESTING)
# -----------------------------------------------------------------------------

SSL_PROVIDER=selfsigned
LETSENCRYPT_STAGING=false
SSL_EMAIL=${ADMIN_EMAIL}

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# -----------------------------------------------------------------------------

# Backup directory (Windows path - will be created)
BACKUP_DIR=c:/Users/lelis/Documents/Mesob_Projects/mesob-backups-local

# Backup retention (shorter for local testing)
BACKUP_RETENTION_DAILY=3
BACKUP_RETENTION_WEEKLY=2
BACKUP_RETENTION_MONTHLY=2

# Backup schedule (disabled for local testing)
BACKUP_SCHEDULE=0 2 * * *

# Backup compression
BACKUP_COMPRESSION=6

# Off-site backup (disabled for local)
OFFSITE_BACKUP_ENABLED=false

# -----------------------------------------------------------------------------
# EMAIL/SMTP CONFIGURATION (DISABLED FOR LOCAL TESTING)
# -----------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=STARTTLS
EMAIL_FROM=

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------

# Log level (debug for local testing)
LOG_LEVEL=info

# Log retention
LOG_RETENTION_DAYS=7

# Maximum log file size
LOG_MAX_SIZE=100

# Access logs
ACCESS_LOGS_ENABLED=true

# -----------------------------------------------------------------------------
# MONITORING CONFIGURATION
# -----------------------------------------------------------------------------

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# SECURITY SETTINGS (RELAXED FOR LOCAL TESTING)
# -----------------------------------------------------------------------------

FAIL2BAN_ENABLED=false
FAIL2BAN_MAX_RETRY=5
FAIL2BAN_BAN_TIME=3600
UFW_ENABLED=false
SSH_PORT=22
SSH_ALLOWED_IPS=
AUTO_SECURITY_UPDATES=false

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING
# -----------------------------------------------------------------------------

REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
VARNISH_ENABLED=false
VARNISH_CACHE_SIZE=256

# -----------------------------------------------------------------------------
# DEVELOPMENT/DEBUG SETTINGS
# -----------------------------------------------------------------------------

# Debug mode (can enable for local testing)
DEBUG_MODE=false

# Developer mode (can enable for local testing)
DEV_MODE=

# Test mode
TEST_ENABLE=false

# Allow database manager (enabled for local testing)
ALLOW_DB_MANAGER=True

# -----------------------------------------------------------------------------
# CONTAINER SETTINGS
# -----------------------------------------------------------------------------

RESTART_POLICY=unless-stopped
CONTAINER_TZ=${TZ}
PUID=1000
PGID=1000

# =============================================================================
# LOCAL TESTING NOTES
# =============================================================================
#
# This configuration is for LOCAL TESTING on Windows PC only.
#
# Differences from production:
# - Simpler passwords (NEVER use these in production!)
# - List databases enabled
# - Database manager enabled
# - Fewer workers (2 instead of 5)
# - Reduced memory limits
# - No SSL/TLS
# - No email configuration
# - No firewall/fail2ban
# - Shorter backup retention
#
# Access after starting:
# - HTTP: http://localhost
# - Odoo Direct: http://localhost:8069
#
# =============================================================================
