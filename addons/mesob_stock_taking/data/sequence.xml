<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for Stock Taking (4.8) -->
    <record id="seq_mesob_stock_taking" model="ir.sequence">
        <field name="name">Mesob Stock Taking</field>
        <field name="code">mesob.stock.taking</field>
        <field name="prefix">ST/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Handover Certificate (4.9) -->
    <record id="seq_mesob_stock_handover" model="ir.sequence">
        <field name="name">Mesob Stock Handover</field>
        <field name="code">mesob.stock.handover</field>
        <field name="prefix">HO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
