<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mesob_inventory_base.Dashboard">
        <div class="mesob_dashboard_container">
            <!-- Welcome Header -->
            <div class="mesob_dashboard_header">
                <div class="mesob_dashboard_logo"></div>
                <h1>Mesob Inventory Management System</h1>
                <p class="mesob_dashboard_subtitle">FDRE Mesob Center - Federal Democratic Republic of Ethiopia</p>
            </div>

            <!-- Quick Actions Grid -->
            <div class="mesob_dashboard_grid">
                <!-- Operations -->
                <div class="mesob_dashboard_card" data-menu="menu_mesob_inventory_operations">
                    <div class="card_icon">📦</div>
                    <h3>Operations</h3>
                    <p>Requisitions, Receiving, Issue Vouchers</p>
                </div>

                <!-- Dispatch -->
                <div class="mesob_dashboard_card" data-menu="menu_mesob_inventory_dispatch">
                    <div class="card_icon">🚚</div>
                    <h3>Dispatch</h3>
                    <p>Gate Pass Management &amp; Authorization</p>
                </div>

                <!-- Documents -->
                <div class="mesob_dashboard_card" data-menu="menu_mesob_inventory_documents">
                    <div class="card_icon">📄</div>
                    <h3>Documents</h3>
                    <p>Model 19 Receipts, DSR Reports</p>
                </div>

                <!-- Stock Records -->
                <div class="mesob_dashboard_card" data-menu="menu_mesob_inventory_stock_records">
                    <div class="card_icon">📊</div>
                    <h3>Stock Records</h3>
                    <p>Bin Cards, Stock Valuation, FIFO</p>
                </div>

                <!-- Stock Control -->
                <div class="mesob_dashboard_card" data-menu="menu_mesob_inventory_stock_control">
                    <div class="card_icon">⚠️</div>
                    <h3>Stock Control</h3>
                    <p>Reorder Alerts, Stock Parameters</p>
                </div>

                <!-- Master Data -->
                <div class="mesob_dashboard_card" data-menu="menu_mesob_inventory_master_data">
                    <div class="card_icon">🗂️</div>
                    <h3>Master Data</h3>
                    <p>Items, Classifications, Setup</p>
                </div>
            </div>

            <!-- System Info -->
            <div class="mesob_dashboard_footer">
                <p>Mesob Inventory Management System - Professional inventory management for Ethiopian government institutions</p>
            </div>
        </div>
    </t>
</templates>
