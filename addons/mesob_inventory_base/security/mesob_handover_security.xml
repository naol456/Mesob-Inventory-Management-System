<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Handover Event Record Rules -->
        
        <!-- PAO: Full Access -->
        <record id="handover_event_pao_rule" model="ir.rule">
            <field name="name">PAO: Full Access to Handover Events</field>
            <field name="model_id" ref="model_mesob_inventory_handover_event"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mesob_pao'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Storekeeper: Read/Write Own Handovers -->
        <record id="handover_event_storekeeper_rule" model="ir.rule">
            <field name="name">Storekeeper: Own Handover Events</field>
            <field name="model_id" ref="model_mesob_inventory_handover_event"/>
            <field name="domain_force">['|', ('outgoing_storekeeper_id', '=', user.id), ('incoming_storekeeper_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mesob_storekeeper'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
    </data>
</odoo>
