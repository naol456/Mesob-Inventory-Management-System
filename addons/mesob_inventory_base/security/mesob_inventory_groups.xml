<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Module category to group Mesob Inventory roles in Settings -->
    <record id="module_category_mesob_inventory" model="ir.module.category">
        <field name="name">Mesob Inventory</field>
        <field name="sequence">30</field>
    </record>

    <!-- Privilege for Mesob Inventory groups -->
    <record id="privilege_mesob_inventory" model="res.groups.privilege">
        <field name="name">Mesob Inventory</field>
        <field name="category_id" ref="module_category_mesob_inventory"/>
        <field name="sequence">30</field>
    </record>

    <!-- 
        BASE ROLE — all staff who raise requisitions inherit this.
        record rule_requisition_user_own restricts them to own records.
    -->
    <record id="group_mesob_inventory_user" model="res.groups">
        <field name="name">Inventory User</field>
        <field name="privilege_id" ref="privilege_mesob_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 
        STOREKEEPER — does NOT inherit group_mesob_inventory_user.
        Reason: inheriting it would pull in rule_requisition_user_own
        (requested_by_id = user.id) and AND it with the storekeeper
        "see-all" rule, restricting them to their own records only.
        Storekeeper gets base.group_user directly for portal/menu access.
    -->
    <record id="group_mesob_storekeeper" model="res.groups">
        <field name="name">Storekeeper</field>
        <field name="privilege_id" ref="privilege_mesob_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- STOCK CLERK — sees all requisitions, so same fix as storekeeper -->
    <record id="group_mesob_stock_clerk" model="res.groups">
        <field name="name">Stock Clerk</field>
        <field name="privilege_id" ref="privilege_mesob_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- PROCUREMENT OFFICER — raises requisitions like normal staff -->
    <record id="group_mesob_procurement" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="privilege_id" ref="privilege_mesob_inventory"/>
        <field name="implied_ids" eval="[(4, ref('mesob_inventory_base.group_mesob_inventory_user'))]"/>
    </record>

    <!-- 
        PAO — does NOT inherit group_mesob_inventory_user.
        Same reason as Storekeeper: inheriting it pulls in the own-record
        rule and ANDs it with PAO's see-all rule, breaking visibility.
        PAO gets base.group_user directly.
    -->
    <record id="group_mesob_pao" model="res.groups">
        <field name="name">Property Admin Officer (PAO)</field>
        <field name="privilege_id" ref="privilege_mesob_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- DEPARTMENT HEAD — raises and approves dept requisitions -->
    <record id="group_mesob_dept_head" model="res.groups">
        <field name="name">User Department Head</field>
        <field name="privilege_id" ref="privilege_mesob_inventory"/>
        <field name="implied_ids" eval="[(4, ref('mesob_inventory_base.group_mesob_inventory_user'))]"/>
    </record>

    <!-- INTERNAL AUDITOR — read-only across everything -->
    <record id="group_mesob_auditor" model="res.groups">
        <field name="name">Internal Auditor</field>
        <field name="privilege_id" ref="privilege_mesob_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- SECURITY GUARD — gate control only -->
    <record id="group_mesob_security_guard" model="res.groups">
        <field name="name">Security Guard</field>
        <field name="privilege_id" ref="privilege_mesob_inventory"/>
        <field name="implied_ids" eval="[(4, ref('mesob_inventory_base.group_mesob_inventory_user'))]"/>
    </record>
</odoo>
