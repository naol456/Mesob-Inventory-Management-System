        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Stock Clerk: Read-only access to all Model 19 receipts -->
    <record id="rule_model19_stock_clerk" model="ir.rule">
        <field name="name">Stock Clerk: Read-only access to Model 19 receipts</field>
        <field name="model_id" ref="model_mesob_inventory_model19"/>
        <field name="groups" eval="[(6, 0, [ref('group_mesob_stock_clerk')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>
