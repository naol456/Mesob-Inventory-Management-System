<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════════
         Record Rules for Issue of Stocks
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- PAO can see all requisitions from ALL users -->
    <record id="rule_requisition_pao_all" model="ir.rule">
        <field name="name">PAO: All Requisitions</field>
        <field name="model_id" ref="model_mesob_inventory_requisition"/>
        <field name="groups" eval="[(6, 0, [ref('group_mesob_pao')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Storekeeper can view all requisitions from ALL users -->
    <record id="rule_requisition_storekeeper" model="ir.rule">
        <field name="name">Storekeeper: All Requisitions</field>
        <field name="model_id" ref="model_mesob_inventory_requisition"/>
        <field name="groups" eval="[(6, 0, [ref('group_mesob_storekeeper')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Stock Clerk can view all requisitions -->
    <record id="rule_requisition_stock_clerk" model="ir.rule">
        <field name="name">Stock Clerk: All Requisitions</field>
        <field name="model_id" ref="model_mesob_inventory_requisition"/>
        <field name="groups" eval="[(6, 0, [ref('group_mesob_stock_clerk')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Basic users can see ONLY their own requisitions -->
    <record id="rule_requisition_user_own" model="ir.rule">
        <field name="name">User: Own Requisitions Only</field>
        <field name="model_id" ref="model_mesob_inventory_requisition"/>
        <field name="groups" eval="[(6, 0, [ref('group_mesob_inventory_user')])]"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>
