<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AUTO-008: Supplier Registration Expiry Alerts -->
    <record id="ir_cron_check_supplier_registration_expiry" model="ir.cron">
        <field name="name">AUTO-008: Check Supplier Registration Expiry</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_supplier_registration_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    
    <!-- AUTO-024: Scheduled Action for Overdue PO Alerts -->
    <record id="ir_cron_check_overdue_pos" model="ir.cron">
        <field name="name">AUTO-024: Check Overdue Purchase Orders</field>
        <field name="model_id" ref="model_mesob_procurement_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_overdue_pos()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    
    <!-- AUTO-019: Scheduled Action for Guarantee Expiry Alerts -->
    <record id="ir_cron_check_guarantee_expiry" model="ir.cron">
        <field name="name">AUTO-019: Check Performance Security &amp; Guarantee Expiry</field>
        <field name="model_id" ref="model_mesob_procurement_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_guarantee_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    
    <!-- AUTO-020: Scheduled Action for Milestone Alerts -->
    <record id="ir_cron_check_milestone_alerts" model="ir.cron">
        <field name="name">AUTO-020: Check Contract Delivery Milestones</field>
        <field name="model_id" ref="model_mesob_contract_milestone"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_milestone_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
