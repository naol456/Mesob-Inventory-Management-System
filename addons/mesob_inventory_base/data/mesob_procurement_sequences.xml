<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Auto-numbering sequence for APP -->
    <record id="seq_mesob_procurement_plan" model="ir.sequence">
        <field name="name">Mesob Annual Procurement Plan</field>
        <field name="code">mesob.procurement.plan</field>
        <field name="prefix">APP-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Auto-numbering sequence for Tender -->
    <record id="seq_mesob_procurement_tender" model="ir.sequence">
        <field name="name">Mesob Tender</field>
        <field name="code">mesob.procurement.tender</field>
        <field name="prefix">TEN-%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Auto-numbering sequence for Purchase Order -->
    <record id="seq_mesob_procurement_order" model="ir.sequence">
        <field name="name">Mesob Purchase Order</field>
        <field name="code">mesob.procurement.order</field>
        <field name="prefix">M-PO-%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Auto-numbering sequence for Payment Certificates -->
    <record id="seq_mesob_procurement_payment_certificate" model="ir.sequence">
        <field name="name">Mesob Payment Certificate</field>
        <field name="code">mesob.procurement.payment.certificate</field>
        <field name="prefix">PAY-%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Auto-numbering sequence for Complaints Register -->
    <record id="seq_mesob_procurement_complaint" model="ir.sequence">
        <field name="name">Mesob Procurement Complaint</field>
        <field name="code">mesob.procurement.complaint</field>
        <field name="prefix">COM-%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
