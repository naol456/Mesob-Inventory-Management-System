<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- AUTO-015: Domestic Preference Calculation Sequence -->
    <record id="seq_mesob_domestic_preference_calc" model="ir.sequence">
        <field name="name">Domestic Preference Calculation</field>
        <field name="code">mesob.domestic.preference.calc</field>
        <field name="prefix">DP/%(range_year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- AUTO-030: Liquidated Damages Calculation Sequence -->
    <record id="seq_mesob_liquidated_damages" model="ir.sequence">
        <field name="name">Liquidated Damages Calculation</field>
        <field name="code">mesob.liquidated.damages</field>
        <field name="prefix">LD/%(range_year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- AUTO-031: Price Adjustment Calculation Sequence -->
    <record id="seq_mesob_price_adjustment" model="ir.sequence">
        <field name="name">Price Adjustment Calculation</field>
        <field name="code">mesob.price.adjustment</field>
        <field name="prefix">PA/%(range_year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- AUTO-035: Procurement-Stock Reconciliation Sequence -->
    <record id="seq_mesob_procurement_stock_recon" model="ir.sequence">
        <field name="name">Procurement-Stock Reconciliation</field>
        <field name="code">mesob.procurement.stock.recon</field>
        <field name="prefix">PSR/%(range_year)s/</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- AUTO-055: Stock Accuracy Scorecard Sequence -->
    <!-- Note: Sequence handled in create() method using period_month/period_year -->
    <!-- No ir.sequence needed as format is SAS/YYYY/MM -->
</odoo>
