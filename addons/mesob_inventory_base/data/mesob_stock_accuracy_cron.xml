<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- AUTO-055: Monthly Stock Accuracy Scorecard Generation -->
        <record id="ir_cron_generate_monthly_stock_accuracy" model="ir.cron">
            <field name="name">AUTO-055: Generate Monthly Stock Accuracy Scorecard</field>
            <field name="model_id" ref="model_mesob_stock_accuracy_scorecard"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_scorecard()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

    </data>
</odoo>
