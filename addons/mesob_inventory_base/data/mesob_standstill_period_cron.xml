<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- AUTO-017: Daily cron to check standstill period expiry -->
        <record id="ir_cron_check_standstill_periods" model="ir.cron">
            <field name="name">Procurement: Check Standstill Periods</field>
            <field name="model_id" ref="model_mesob_procurement_tender"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_standstill_periods()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>
    </data>
</odoo>
