<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- AUTO-023: Daily Reorder-Level Auto-Requisition Cron -->
        <record id="ir_cron_auto_reorder_check" model="ir.cron">
            <field name="name">AUTO-023: Reorder-Level Auto-Requisition Generator</field>
            <field name="model_id" ref="model_mesob_auto_po_generator"/>
            <field name="state">code</field>
            <field name="code">model.check_reorder_levels_and_generate_requisitions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>
        
    </data>
</odoo>
