<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- AUTO-062 + AUTO-065: Periodic Control Level Recalculation -->
    <record id="cron_recalculate_control_levels" model="ir.cron">
        <field name="name">AUTO-062/065: Recalculate Control Levels</field>
        <field name="model_id" ref="model_mesob_inventory_item"/>
        <field name="state">code</field>
        <field name="code">model.cron_recalculate_control_levels()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
        <field name="priority">10</field>
    </record>

    <!-- AUTO-066: Dormant Item Flagging -->
    <record id="cron_flag_dormant_items" model="ir.cron">
        <field name="name">AUTO-066: Flag Dormant/Slow-Moving Items</field>
        <field name="model_id" ref="model_mesob_inventory_item"/>
        <field name="state">code</field>
        <field name="code">model.cron_flag_dormant_items()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="priority">15</field>
    </record>
</odoo>
