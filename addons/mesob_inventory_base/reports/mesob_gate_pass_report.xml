                            </div>
                            <div class="col-6">
                                <h5 style="color: #0B1B3D; font-weight: bold; border-bottom: 1px solid #dee2e6; padding-bottom: 5px;">Issuing Details</h5>
                                <strong>Issue Mode:</strong> <span t-field="o.issue_mode"/><br/>
                                <strong>Status:</strong> <span t-field="o.state"/>
                            </div>
                        </div>

                        <!-- Line Items Table -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5 style="color: #0B1B3D; font-weight: bold;">Items Requested</h5>
                                <table class="table table-sm table-bordered" style="font-size: 12px; border-color: #dee2e6;">
                                    <thead>
                                        <tr style="background-color: #0B1B3D; color: #FFFFFF;">
                                            <th style="padding: 6px;">#</th>
                                            <th style="padding: 6px;">Item Code</th>
                                            <th style="padding: 6px;">Item Name</th>
                                            <th class="text-right" style="padding: 6px;">Qty Requested</th>
