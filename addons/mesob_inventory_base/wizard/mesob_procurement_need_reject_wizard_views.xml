<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AUTO-001: Procurement Need Rejection Wizard -->
    <record id="view_mesob_procurement_need_reject_wizard_form" model="ir.ui.view">
        <field name="name">mesob.procurement.need.reject.wizard.form</field>
        <field name="model">mesob.procurement.need.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Procurement Need">
                <group>
                    <field name="need_id" invisible="1"/>
                    <field name="rejection_reason" placeholder="Enter detailed reason for rejection (minimum 10 characters)..." widget="text"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Rejection" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
