<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mesob_requisition_reject_wizard_form" model="ir.ui.view">
        <field name="name">mesob.requisition.reject.wizard.form</field>
        <field name="model">mesob.requisition.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Requisition">
                <div class="alert alert-warning mb-3" role="alert">
                    <strong>AUTO-042:</strong> Provide detailed rejection reason. Requester will be notified automatically.
                </div>
                
                <group>
                    <field name="requisition_id" readonly="1"/>
                </group>
                
                <group>
                    <field name="rejection_reason" nolabel="1" 
                           placeholder="Explain why this requisition is being rejected (e.g., insufficient budget, items not approved, incomplete justification, stock unavailable)..."
                           class="w-100 border p-3 rounded" 
                           style="min-height: 120px;"/>
                </group>
                
                <footer>
                    <button name="action_confirm_rejection" type="object" 
                            string="Confirm Rejection" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
