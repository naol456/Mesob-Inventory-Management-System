<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- AUTO-002: Intelligent Needs Consolidation Wizard Views -->
    
    <!-- Consolidation Group Preview Tree -->
    <record id="view_mesob_consolidation_group_preview_tree" model="ir.ui.view">
        <field name="name">mesob.consolidation.group.preview.tree</field>
        <field name="model">mesob.consolidation.group.preview</field>
        <field name="arch" type="xml">
            <list string="Consolidation Preview" editable="bottom">
                <field name="include_in_consolidation" widget="boolean_toggle"/>
                <field name="suggested_lot_name"/>
                <field name="need_count"/>
                <field name="total_budget" sum="Total Budget"/>
                <field name="suggested_mechanism" widget="badge" 
                       decoration-success="suggested_mechanism == 'bidding'"
                       decoration-info="suggested_mechanism == 'shopping'"
                       decoration-warning="suggested_mechanism == 'direct'"/>
                <field name="need_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    
    <!-- Intelligent Consolidation Wizard Form -->
    <record id="view_mesob_intelligent_consolidation_wizard_form" model="ir.ui.view">
        <field name="name">mesob.intelligent.consolidation.wizard.form</field>
        <field name="model">mesob.intelligent.consolidation.wizard</field>
        <field name="arch" type="xml">
            <form string="AUTO-002: Intelligent Needs Consolidation">
                <header>
                    <button name="action_preview_consolidation" 
                            string="Generate Preview" 
                            type="object" 
                            class="oe_highlight"/>
                    <button name="action_confirm_consolidation" 
                            string="Create Lots" 
                            type="object" 
                            class="btn-success" 
                            invisible="not group_preview_ids"
                            confirm="Are you sure you want to create lots from this consolidation?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Intelligent Needs Consolidation</span>
                        </h1>
                        <h2>
                            <field name="plan_id" readonly="1" class="oe_inline"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group string="Consolidation Strategy">
                            <field name="consolidation_strategy" widget="radio"/>
                            <field name="keyword_threshold" 
                                   invisible="consolidation_strategy != 'by_keywords'"
                                   widget="percentage"/>
                        </group>
                        <group string="Preview Statistics">
                            <field name="total_needs"/>
                            <field name="total_groups"/>
                            <field name="total_budget" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <div class="alert alert-info" role="alert" style="margin: 16px 0;">
                        <h4 class="alert-heading">Consolidation Strategy Guide:</h4>
                        <ul style="margin-bottom: 0;">
                            <li><strong>By Exact Item Code:</strong> Groups identical items from different departments</li>
                            <li><strong>By Sub-Classification:</strong> Groups items within same sub-category (e.g., all office supplies)</li>
                            <li><strong>By Major Classification:</strong> Groups items within same major category (e.g., all consumables)</li>
                            <li><strong>By Keyword Similarity:</strong> Intelligently groups similar items using AI-based keyword matching</li>
                        </ul>
                    </div>
                    
                    <notebook invisible="not group_preview_ids">
                        <page string="Consolidation Preview" name="preview">
                            <field name="group_preview_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="include_in_consolidation" widget="boolean_toggle"/>
                                    <field name="suggested_lot_name"/>
                                    <field name="need_count"/>
                                    <field name="total_budget" sum="Total Budget"/>
                                    <field name="suggested_mechanism" widget="badge" 
                                           decoration-success="suggested_mechanism == 'bidding'"
                                           decoration-info="suggested_mechanism == 'shopping'"
                                           decoration-warning="suggested_mechanism == 'direct'"/>
                                    <button name="%(action_view_consolidation_group_needs)d" 
                                            string="View Needs" 
                                            type="action" 
                                            icon="fa-list"
                                            context="{'default_need_ids': need_ids}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action: Open Consolidation Group Needs -->
    <record id="action_view_consolidation_group_needs" model="ir.actions.act_window">
        <field name="name">Needs in Group</field>
        <field name="res_model">mesob.procurement.need</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('id', 'in', context.get('default_need_ids', []))]</field>
        <field name="context">{}</field>
    </record>
    
    <!-- Action: Launch Intelligent Consolidation Wizard -->
    <record id="action_intelligent_consolidation_wizard" model="ir.actions.act_window">
        <field name="name">Intelligent Consolidation</field>
        <field name="res_model">mesob.intelligent.consolidation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_mesob_procurement_plan"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
