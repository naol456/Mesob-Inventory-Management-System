<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AUTO-043: Stock Availability Alert Wizard Form View -->
    <record id="view_mesob_requisition_stock_alert_wizard_form" model="ir.ui.view">
        <field name="name">mesob.requisition.stock.alert.wizard.form</field>
        <field name="model">mesob.requisition.stock.alert.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Availability Alert">
                <sheet>
                    <group>
                        <field name="requisition_id" invisible="1"/>
                        <field name="stock_warnings" invisible="1"/>
                    </group>
                    
                    <group>
                        <field name="warning_message" nolabel="1" colspan="2"/>
                    </group>
                    
                    <separator string="PAO Decision"/>
                    
                    <group>
                        <field name="action_type" widget="radio"/>
                    </group>
                    
                    <group attrs="{'invisible': [('action_type', '!=', 'override')]}">
                        <field name="override_reason" 
                               placeholder="Explain why this requisition must be approved despite stock shortages..."
                               required="action_type == 'override'"/>
                    </group>
                </sheet>
                
                <footer>
                    <button name="action_proceed" 
                            string="Proceed" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
