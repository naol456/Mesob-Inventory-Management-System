<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ── List View ──────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_item_list" model="ir.ui.view">
        <field name="name">mesob.inventory.item.list</field>
        <field name="model">mesob.inventory.item</field>
        <field name="arch" type="xml">
            <list string="Inventory Items" default_order="item_code">
                <field name="item_code"/>
                <field name="name"/>
                <field name="classification_id"/>
                <field name="sub_classification_id"/>
                <field name="is_controlled" optional="hide"/>
                <field name="reorder_level" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_item_form" model="ir.ui.view">
        <field name="name">mesob.inventory.item.form</field>
        <field name="model">mesob.inventory.item</field>
        <field name="arch" type="xml">
            <form string="Inventory Item">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Item name (English)..."/>
                        </h1>
                        <field name="name_am" placeholder="Item name (Amharic)..."/>
                    </div>

                    <group>
                        <group string="Item Code">
                            <field name="item_code" placeholder="e.g. 4401-001-001"/>
                            <field name="classification_id"/>
                            <field name="sub_classification_id"/>
                            <field name="major_code" readonly="True"/>
                            <field name="sub_code" readonly="True"/>
                            <field name="specific_code" readonly="True"/>
                        </group>
                        <group string="General">
                            <field name="is_controlled"/>
                            <field name="exclude_from_catalog"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Stock Control" name="stock_control">
                            <group>
                                <group string="Stock Levels">
                                    <field name="minimum_level"/>
                                    <field name="reorder_level"/>
                                    <field name="hastening_level"/>
                                    <field name="maximum_level"/>
                                    <field name="safety_stock"/>
                                </group>
                                <group string="Lead Times">
                                    <field name="admin_lead_time"/>
                                    <field name="supplier_lead_time"/>
                                </group>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Additional details about this item..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_item_search" model="ir.ui.view">
        <field name="name">mesob.inventory.item.search</field>
        <field name="model">mesob.inventory.item</field>
        <field name="arch" type="xml">
            <search string="Inventory Items">
                <field name="item_code"/>
                <field name="name"/>
                <field name="classification_id"/>
                <field name="sub_classification_id"/>
                <filter string="Controlled" name="filter_controlled"
                        domain="[('is_controlled', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────── -->
    <record id="action_mesob_inventory_item" model="ir.actions.act_window">
        <field name="name">Inventory Items</field>
        <field name="res_model">mesob.inventory.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an inventory item
            </p>
            <p>
                Items use the FDRE coding format ####-###-### and are linked
                to a major classification (4401–4418) for stock accounting.
            </p>
        </field>
    </record>

    <!-- ── Kanban View for Stock Card Item Selection ────────────────────── -->
    <record id="view_mesob_inventory_item_kanban_stock_card" model="ir.ui.view">
        <field name="name">mesob.inventory.item.kanban.stock.card</field>
        <field name="model">mesob.inventory.item</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="item_code"/>
                <field name="current_stock"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click" type="object" name="action_view_stock_record_ledger" style="padding: 16px; border-radius: 12px; border: 1px solid #e2e8f0; background: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); margin-bottom: 12px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="font-size: 32px; min-width: 45px; text-align: center;">📦</div>
                                <div style="flex: 1;">
                                    <div style="font-weight: 700; font-size: 15px; color: #0f172a;">
                                        <field name="name"/>
                                    </div>
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                                        Item Code: <span style="font-weight: 600;"><field name="item_code"/></span>
                                    </div>
                                </div>
                                <div style="background: #f0fdf4; padding: 4px 10px; border-radius: 15px; font-size: 11px; font-weight: 600; color: #16a34a; border: 1px solid #bbf7d0;">
                                    <field name="current_stock"/> in stock
                                </div>
                            </div>
                            <div style="margin-top: 14px; border-top: 1px dashed #e2e8f0; padding-top: 10px; display: flex; justify-content: flex-end;">
                                <button class="btn btn-primary btn-sm" type="object" name="action_view_stock_record_ledger" style="font-weight: 600; padding: 4px 12px; font-size: 11px; border-radius: 6px;">
                                    View Stock Record Card
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Detailed Stock Record Card / Ledger Form View ────────────────────── -->
    <record id="view_mesob_inventory_item_form_ledger" model="ir.ui.view">
        <field name="name">mesob.inventory.item.form.ledger</field>
        <field name="model">mesob.inventory.item</field>
        <field name="arch" type="xml">
            <form string="Stock Record Card" class="o_mesob_gov_doc">
                <sheet>
                    <!-- Government Document Header -->
                    <div class="mesob_gov_header">
                        <div class="mesob_gov_logo">M</div>
                        <h1 class="mesob_gov_title">Federal Democratic Republic of Ethiopia</h1>
                        <h3 class="mesob_gov_subtitle">Stock Record Card (Model 19)</h3>
                        <div class="mesob_gov_underline"></div>
                    </div>

                    <group>
                        <group string="Item Information">
                            <field name="name" readonly="1" string="Item Name"/>
                            <field name="item_code" readonly="1" string="Item Code"/>
                            <field name="uom_id" readonly="1" string="Unit of Measure"/>
                        </group>
                        <group string="Classification Info">
                            <field name="classification_id" readonly="1" string="Major Classification"/>
                            <field name="sub_classification_id" readonly="1" string="Sub Classification"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📈 Valuation &amp; Transaction Ledger" name="stock_record_ledger">
                            <field name="stock_record_ids" readonly="1">
                                <list string="Stock Record Lines" default_order="date asc, id asc">
                                    <field name="date" string="Date"/>
                                    <field name="reference" string="Ref Document"/>
                                    <field name="transaction_type" string="Type" widget="badge"
                                           decoration-info="transaction_type == 'receipt'"
                                           decoration-warning="transaction_type == 'issue'"
                                           decoration-success="transaction_type == 'opening'"/>
                                    
                                    <!-- Received Section -->
                                    <field name="quantity_in" string="Received Qty" sum="Total In"/>
                                    <field name="unit_cost" string="Received Unit Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_cost_in" string="Received Total Price" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Cost In"/>
                                    
                                    <!-- Issued Section -->
                                    <field name="quantity_out" string="Issued Qty" sum="Total Out"/>
                                    <field name="unit_cost_out" string="Issued Unit Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_cost_out" string="Issued Total Price" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Cost Out"/>
                                    
                                    <!-- Balance Section -->
                                    <field name="quantity_balance" string="Balance Qty" decoration-bf="1"/>
                                    <field name="average_cost" string="Balance Unit Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="balance_value" string="Balance Total Price" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1" sum="Total Balance Value"/>
                                    
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
