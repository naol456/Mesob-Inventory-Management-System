<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mesob_inventory_item_list" model="ir.ui.view">
        <field name="name">mesob.inventory.item.list</field>
        <field name="model">mesob.inventory.item</field>
        <field name="arch" type="xml">
            <list string="Items">
                <field name="item_code"/>
                <field name="major_code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mesob_inventory_item_form" model="ir.ui.view">
        <field name="name">mesob.inventory.item.form</field>
        <field name="model">mesob.inventory.item</field>
        <field name="arch" type="xml">
            <form string="Item">
                <sheet>
                    <group>
                        <group>
                            <field name="item_code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="major_code"/>
                            <field name="sub_code"/>
                            <field name="specific_code"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mesob_inventory_item_search" model="ir.ui.view">
        <field name="name">mesob.inventory.item.search</field>
        <field name="model">mesob.inventory.item</field>
        <field name="arch" type="xml">
            <search string="Items">
                <field name="item_code"/>
                <field name="name"/>
                <field name="major_code"/>
                <filter string="Group by Major Code" context="{'group_by': 'major_code'}"/>
            </search>
        </field>
    </record>

    <record id="action_mesob_inventory_item" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">mesob.inventory.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
