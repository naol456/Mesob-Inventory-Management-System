<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ── List View ──────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_model19_list" model="ir.ui.view">
        <field name="name">mesob.inventory.model19.list</field>
        <field name="model">mesob.inventory.model19</field>
        <field name="arch" type="xml">
            <list string="Receipts (Model 19)" default_order="date desc"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'distributed'">
                <field name="name" class="fw-bold font-monospace text-primary"/>
                <field name="date" class="font-monospace text-muted"/>
                <field name="supplier_id" class="fw-semibold text-muted"/>
                <field name="receiving_id" optional="show" class="font-monospace text-muted"/>
                <field name="is_no_payment" optional="hide"/>
                <field name="total_amount" sum="Total" class="text-end fw-bold font-monospace text-primary"/>
                <field name="copy_accounts" optional="show"/>
                <field name="copy_stock_clerk" optional="show"/>
                <field name="copy_supplier" optional="hide"/>
                <field name="copy_storekeeper" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'distributed'"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_model19_kanban" model="ir.ui.view">
        <field name="name">mesob.inventory.model19.kanban</field>
        <field name="model">mesob.inventory.model19</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" drag_drop="false" class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="date"/>
                <field name="supplier_id"/>
                <field name="total_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click card shadow-sm border-0 rounded p-3 mb-3 bg-white" style="min-height: 120px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary text-white font-monospace fs-6 px-2 py-1">
                                    <t t-esc="record.name.value"/>
                                </span>
                                <span class="badge bg-secondary text-white px-2 py-1 small">
                                    <i class="fa fa-tag me-1"/>Model 19
                                </span>
                            </div>
                            <h4 class="o_kanban_record_title fw-bold text-dark fs-5 mb-1 mt-1">
                                <t t-esc="record.supplier_id.value or 'Department Return'"/>
                            </h4>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="text-muted small">
                                    <i class="fa fa-usd me-1"/> <t t-esc="record.total_amount.value"/>
                                </span>
                                <span class="text-muted small font-monospace">
                                    <i class="fa fa-calendar me-1"/> <t t-esc="record.date.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_model19_form" model="ir.ui.view">
        <field name="name">mesob.inventory.model19.form</field>
        <field name="model">mesob.inventory.model19</field>
        <field name="arch" type="xml">
            <form string="Receipt for Articles/Property (Model 19)" class="o_mesob_gov_doc">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="mesob_inventory_base.group_mesob_storekeeper"/>
                    <button name="action_mark_distributed" type="object"
                            string="Mark Distributed" class="btn-success"
                            invisible="state != 'confirmed'"
                            groups="mesob_inventory_base.group_mesob_storekeeper"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,distributed"/>
                </header>
                <sheet>
                    <!-- Premium Reusable Corporate Form Header -->
                    <div class="mesob_corporate_header">
                        <div class="mesob_header_logo_container">
                            <img src="/mesob_inventory_base/static/img/mesob_logo.png" alt="FDRE Logo"/>
                            <div class="mesob_header_company_name">FDRE Mesob Center</div>
                        </div>
                        <div class="mesob_header_bottom_row">
                            <div class="mesob_header_id">
                                <field name="name" readonly="1"/>
                            </div>
                            <div class="mesob_header_title">Receipt for Articles/Property (Model 19)</div>
                        </div>
                    </div>

                    <!-- Document Content: Symmetrical Groups -->
                    <group class="mb-4" col="2">
                        <group string="Receipt Details" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="date" readonly="state != 'draft'" class="mb-3 font-monospace"/>
                            <field name="receiving_id" readonly="1" class="mb-3"/>
                        </group>
                        <group string="Supplier Information" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="supplier_id" readonly="state != 'draft'" class="mb-3"/>
                            <field name="is_no_payment" readonly="1" class="mb-3"/>
                            <field name="total_amount" class="text-end fw-bold font-monospace text-primary mb-3"/>
                        </group>
                    </group>

                    <notebook class="mt-4">
                        <page string="Receipt Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" class="glass-table border-0 rounded shadow-sm">
                                    <field name="item_id" options="{'no_open': True, 'no_create': True}" class="fw-semibold"/>
                                    <field name="description" placeholder="Item description..."/>
                                    <field name="quantity" class="text-end fw-bold font-monospace text-primary" style="font-size: 1.1em;"/>
                                    <field name="uom_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="unit_price" class="text-end font-monospace text-success"/>
                                    <field name="total_price" class="text-end fw-bold font-monospace text-primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Copy Distribution (FR-REC-006)" name="copies">
                            <group class="p-3" col="2">
                                <group string="Distribution Status" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                                    <field name="copy_accounts" readonly="state == 'distributed'" widget="radio" options="{'horizontal': true}" class="mb-3"/>
                                    <field name="copy_stock_clerk" readonly="state == 'distributed'" widget="radio" options="{'horizontal': true}" class="mb-3"/>
                                    <field name="copy_supplier" readonly="state == 'distributed'" widget="radio" options="{'horizontal': true}" class="mb-3"/>
                                    <field name="copy_storekeeper" readonly="state == 'distributed'" widget="radio" options="{'horizontal': true}" class="mb-3"/>
                                </group>
                                <group string="Auditing" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                                    <field name="all_copies_distributed" readonly="1" class="mb-3"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-3" role="alert">
                                <i class="fa fa-info-circle me-2"/> 
                                <strong>Note:</strong> Mark all four copies as "Distributed" before clicking the "Mark Distributed" button.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────── -->
    <record id="action_mesob_inventory_model19" model="ir.actions.act_window">
        <field name="name">Receipts (Model 19)</field>
        <field name="res_model">mesob.inventory.model19</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
