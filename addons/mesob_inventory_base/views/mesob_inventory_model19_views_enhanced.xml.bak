<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════
         MODEL 19 (RECEIPTS) - ENHANCED MODERN UI
         ══════════════════════════════════════════════════════════════ -->

    <!-- Enhanced List View with Modern Styling -->
    <record id="view_mesob_inventory_model19_list_enhanced" model="ir.ui.view">
        <field name="name">mesob.inventory.model19.list.enhanced</field>
        <field name="model">mesob.inventory.model19</field>
        <field name="inherit_id" ref="view_mesob_inventory_model19_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">mesob_modern_list</attribute>
                <attribute name="decoration-success">state == 'done'</attribute>
                <attribute name="decoration-info">state == 'draft'</attribute>
            </xpath>
        </field>
    </record>

    <!-- Enhanced Form View with Modern Card Layout -->
    <record id="view_mesob_inventory_model19_form_enhanced" model="ir.ui.view">
        <field name="name">mesob.inventory.model19.form.enhanced</field>
        <field name="model">mesob.inventory.model19</field>
        <field name="inherit_id" ref="view_mesob_inventory_model19_form"/>
        <field name="arch" type="xml">
            <!-- Enhance Header -->
            <xpath expr="//header" position="attributes">
                <attribute name="class">mesob_modern_header</attribute>
            </xpath>

            <!-- Enhance Title Section -->
            <xpath expr="//div[@class='oe_title']/h1" position="attributes">
                <attribute name="class">mesob_form_title</attribute>
            </xpath>

            <!-- Add Info Cards -->
            <xpath expr="//group[1]" position="before">
                <div class="alert alert-success" role="alert">
                    <i class="fa fa-check-circle"/> 
                    <strong>Model 19 (Receipt):</strong> Confirmation of accepted goods after inspection.
                </div>
                <div class="row mesob_info_cards">
                    <div class="col-md-4">
                        <div class="mesob_card text-center">
                            <i class="fa fa-file-text fa-2x text-success mb-2"/>
                            <div class="fw-bold"><field name="receiving_id" readonly="1"/></div>
                            <small class="text-muted">Receiving Order</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mesob_card text-center">
                            <i class="fa fa-calendar fa-2x text-success mb-2"/>
                            <div class="fw-bold"><field name="date" readonly="1"/></div>
                            <small class="text-muted">Receipt Date</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mesob_card text-center">
                            <i class="fa fa-building fa-2x text-success mb-2"/>
                            <div class="fw-bold"><field name="supplier_id" readonly="1"/></div>
                            <small class="text-muted">Supplier</small>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Hide Original Groups -->
            <xpath expr="//group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
