<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Modern UI Assets Bundle -->
    <record id="mesob_inventory_assets" model="ir.asset">
        <field name="name">Mesob Inventory Modern Styles</field>
        <field name="bundle">web.assets_backend</field>
        <field name="path">mesob_inventory_base/static/src/scss/mesob_inventory_modern.scss</field>
    </record>
    
    <record id="mesob_inventory_components_assets" model="ir.asset">
        <field name="name">Mesob Inventory Components</field>
        <field name="bundle">web.assets_backend</field>
        <field name="path">mesob_inventory_base/static/src/scss/mesob_inventory_components.scss</field>
    </record>

    <!-- Login Page Assets -->
    <record id="mesob_login_assets" model="ir.asset">
        <field name="name">Mesob Login Page Styles</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">mesob_inventory_base/static/src/scss/mesob_login.scss</field>
    </record>
</odoo>
