<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Professional UI Styles Bundle -->
    <record id="mesob_inventory_styles" model="ir.asset">
        <field name="name">Mesob Inventory Professional Styles</field>
        <field name="bundle">web.assets_backend</field>
        <field name="path">mesob_inventory_base/static/src/scss/mesob_inventory.scss</field>
    </record>

    <!-- Dashboard JavaScript -->
    <record id="mesob_dashboard_js" model="ir.asset">
        <field name="name">Mesob Dashboard JS</field>
        <field name="bundle">web.assets_backend</field>
        <field name="path">mesob_inventory_base/static/src/js/mesob_dashboard.js</field>
    </record>

    <!-- Dashboard Template -->
    <record id="mesob_dashboard_xml" model="ir.asset">
        <field name="name">Mesob Dashboard Template</field>
        <field name="bundle">web.assets_backend</field>
        <field name="path">mesob_inventory_base/static/src/xml/mesob_dashboard.xml</field>
    </record>
    
    <!-- Login Page Assets -->
    <record id="mesob_login_assets" model="ir.asset">
        <field name="name">Mesob Login Page Styles</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">mesob_inventory_base/static/src/scss/mesob_login.scss</field>
    </record>
</odoo>
