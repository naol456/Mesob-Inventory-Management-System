<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════
         REQUISITION (MODEL 20) - ENHANCED PREMIUM VIEW
         ══════════════════════════════════════════════════════════════ -->

    <!-- Requisition Line Form View - Vertical Layout -->
    <record id="view_mesob_inventory_requisition_line_form" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.line.form</field>
        <field name="model">mesob.inventory.requisition.line</field>
        <field name="arch" type="xml">
            <form string="Add Requisition Item">
                <sheet>
                    <group>
                        <group>
                            <field name="item_id" 
                                   string="📦 Item"
                                   placeholder="Select inventory item..."
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="quantity" 
                                   string="🔢 Quantity"
                                   placeholder="Enter quantity"/>
                        </group>
                        <group>
                            <field name="uom_id" 
                                   string="📏 Unit of Measure"
                                   placeholder="Select unit"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="note" 
                                   string="📝 Remarks"
                                   placeholder="Add notes or special instructions..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Enhanced Form View -->
    <record id="view_mesob_inventory_requisition_form_enhanced" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.form.enhanced</field>
        <field name="model">mesob.inventory.requisition</field>
        <field name="inherit_id" ref="view_mesob_inventory_requisition_form"/>
        <field name="arch" type="xml">
            
            <!-- Approval Timeline at top when approved/rejected -->
            <xpath expr="//div[@class='oe_title']" position="after">
                <div invisible="state not in ('approved', 'rejected', 'issued', 'received')"
                     style="margin: 20px 0; background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); padding: 24px; border-radius: 16px; border: 2px solid #86efac; box-shadow: 0 8px 24px rgba(16, 185, 129, 0.2);">
                    <div style="text-align: center; margin-bottom: 20px;">
                        <div style="display: inline-flex; align-items: center; gap: 12px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 12px 28px; border-radius: 12px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);">
                            <i class="fa fa-check-circle" style="color: white; font-size: 22px;"/>
                            <span style="color: white; font-size: 17px; font-weight: 700; letter-spacing: 0.5px;">APPROVAL WORKFLOW</span>
                        </div>
                    </div>
                    
                    <div style="display: flex; justify-content: center; align-items: center; gap: 20px; flex-wrap: wrap;">
                        <div style="text-align: center; flex: 1; min-width: 150px;">
                            <div style="background: white; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); border: 4px solid #10b981;">
                                <i class="fa fa-paper-plane fa-2x" style="color: #10b981;"/>
                            </div>
                            <div style="font-weight: 700; color: #065f46; font-size: 14px;">Submitted</div>
                        </div>
                        <i class="fa fa-arrow-right fa-2x" style="color: #10b981;"/>
                        <div style="text-align: center; flex: 1; min-width: 150px;">
                            <div style="background: white; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); border: 4px solid #10b981;">
                                <i class="fa fa-check-circle fa-2x" style="color: #10b981;"/>
                            </div>
                            <div style="font-weight: 700; color: #065f46; font-size: 14px;">Approved</div>
                            <div style="font-size: 12px; color: #6b7280;"><field name="approved_by_id" readonly="1"/></div>
                            <div style="font-size: 11px; color: #9ca3af;"><field name="approved_on" readonly="1"/></div>
                        </div>
                        <i class="fa fa-arrow-right fa-2x" style="color: #10b981;" invisible="state not in ('issued', 'received')"/>
                        <div style="text-align: center; flex: 1; min-width: 150px;" invisible="state not in ('issued', 'received')">
                            <div style="background: white; width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); border: 4px solid #10b981;">
                                <i class="fa fa-truck fa-2x" style="color: #10b981;"/>
                            </div>
                            <div style="font-weight: 700; color: #065f46; font-size: 14px;">Issued</div>
                        </div>
                    </div>
                    <div invisible="state != 'rejected'" style="margin-top: 20px; background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%); padding: 16px; border-radius: 12px; border-left: 4px solid #ef4444;">
                        <div style="display: flex; align-items: flex-start; gap: 12px;">
                            <div style="background: #ef4444; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-times-circle" style="color: white; font-size: 20px;"/>
                            </div>
                            <div>
                                <div style="color: #991b1b; font-size: 14px; font-weight: 700;">❌ REJECTED</div>
                                <field name="rejection_reason" readonly="1" style="font-size: 13px; color: #dc2626;"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Hide original groups -->
            <xpath expr="//group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Replace notebook with side-by-side layout -->
            <xpath expr="//notebook" position="replace">
                <div class="row mesob_responsive_row" style="margin: 20px 0;">
                    <!-- Request Information Card (Left Side) -->
                    <div class="col-12 col-lg-6 mesob_responsive_col" style="padding: 0 10px; margin-bottom: 20px;">
                        <div class="mesob_info_card" style="background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%); border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(99, 102, 241, 0.15); border: 2px solid #e0e7ff; height: 100%;">
                            <h3 style="color: #6366f1; font-size: 18px; font-weight: 700; margin: 0 0 20px 0; padding-bottom: 16px; border-bottom: 3px solid #6366f1; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                <div style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);">
                                    <i class="fa fa-file-text-o" style="color: white; font-size: 18px;"/>
                                </div>
                                <span>Request Information</span>
                            </h3>
                            
                            <div style="display: flex; flex-direction: column; gap: 16px;">
                                <div style="background: white; padding: 16px; border-radius: 12px; border-left: 4px solid #6366f1; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fa fa-truck" style="color: white; font-size: 14px;"/>
                                        </div>
                                        <div style="flex: 1;">
                                            <div style="color: #6b7280; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Issue Mode</div>
                                            <field name="issue_mode" readonly="state != 'draft'" style="font-size: 15px; font-weight: 600; color: #1f2937;"/>
                                        </div>
                                    </div>
                                </div>
                                <div style="background: white; padding: 16px; border-radius: 12px; border-left: 4px solid #8b5cf6; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div style="background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%); width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fa fa-building" style="color: white; font-size: 14px;"/>
                                        </div>
                                        <div style="flex: 1;">
                                            <div style="color: #6b7280; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Department</div>
                                            <field name="department" readonly="state != 'draft'" placeholder="Enter department" style="font-size: 15px; font-weight: 600; color: #1f2937;"/>
                                        </div>
                                    </div>
                                </div>
                                <div style="background: white; padding: 16px; border-radius: 12px; border-left: 4px solid #6366f1; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fa fa-user" style="color: white; font-size: 14px;"/>
                                        </div>
                                        <div style="flex: 1;">
                                            <div style="color: #6b7280; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Requested By</div>
                                            <field name="requested_by_id" readonly="state != 'draft'" style="font-size: 15px; font-weight: 600; color: #1f2937;"/>
                                        </div>
                                    </div>
                                </div>
                                <div style="background: white; padding: 16px; border-radius: 12px; border-left: 4px solid #8b5cf6; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div style="background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%); width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fa fa-calendar" style="color: white; font-size: 14px;"/>
                                        </div>
                                        <div style="flex: 1;">
                                            <div style="color: #6b7280; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Request Date</div>
                                            <field name="requested_on" readonly="state != 'draft'" style="font-size: 15px; font-weight: 600; color: #1f2937;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Requisition Items Card (Right Side) -->
                    <div class="col-12 col-lg-6 mesob_responsive_col" style="padding: 0 10px; margin-bottom: 20px;">
                        <div class="mesob_info_card" style="background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%); border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(99, 102, 241, 0.15); border: 2px solid #e0e7ff; height: 100%;">
                            <h3 style="color: #6366f1; font-size: 18px; font-weight: 700; margin: 0 0 20px 0; padding-bottom: 16px; border-bottom: 3px solid #6366f1; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                <div style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);">
                                    <i class="fa fa-shopping-cart" style="color: white; font-size: 18px;"/>
                                </div>
                                <span>📦 Requisition Items</span>
                            </h3>
                            <field name="line_ids" readonly="state != 'draft'" class="mesob_requisition_lines" nolabel="1"/>
                        </div>
                    </div>
                </div>

                <!-- Notes Section (Full Width Below) -->
                <div style="margin: 20px 0; background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%); padding: 24px; border-radius: 16px; border: 2px solid #fef3c7; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.1);">
                    <div style="text-align: center; margin-bottom: 20px;">
                        <div style="display: inline-flex; align-items: center; gap: 12px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); padding: 12px 24px; border-radius: 12px; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);">
                            <i class="fa fa-sticky-note-o" style="color: white; font-size: 20px;"/>
                            <span style="color: white; font-size: 16px; font-weight: 700; letter-spacing: 0.5px;">📝 INTERNAL NOTES</span>
                        </div>
                    </div>
                    <field name="note" 
                           placeholder="Add internal notes, special instructions, or additional information here..."
                           style="min-height: 150px; background: white; border: 2px solid #fef3c7; border-radius: 12px; padding: 16px; font-size: 14px; color: #374151;"/>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
