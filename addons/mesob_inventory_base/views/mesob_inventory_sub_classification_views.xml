<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mesob_sub_classification_list" model="ir.ui.view">
        <field name="name">mesob.inventory.sub.classification.list</field>
        <field name="model">mesob.inventory.sub.classification</field>
        <field name="arch" type="xml">
            <list string="Sub Classifications">
                <field name="code" string="Sub Code"/>
                <field name="name" string="Name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_mesob_sub_classification_kanban_bin_card" model="ir.ui.view">
        <field name="name">mesob.inventory.sub.classification.kanban.bin.card</field>
        <field name="model">mesob.inventory.sub.classification</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="major_classification_id"/>
                <field name="item_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click mesob_classification_card" type="object" name="action_view_bin_card_details">
                            <div class="mesob_card_header">
                                <div class="mesob_card_icon">🧴</div>
                                <div class="mesob_card_content">
                                    <div class="mesob_card_title">
                                        <field name="name"/>
                                    </div>
                                    <div class="mesob_card_subtitle">
                                        Sub Code: <strong><field name="code"/></strong>
                                    </div>
                                </div>
                                <div class="mesob_card_badge">
                                    <field name="item_count"/> items
                                </div>
                            </div>
                            <div class="mesob_card_footer">
                                <button class="btn btn-secondary btn-sm" type="object" name="action_view_bin_card_details">
                                    View Ledger &amp; Items
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_mesob_sub_classification_kanban_stock_card" model="ir.ui.view">
        <field name="name">mesob.inventory.sub.classification.kanban.stock.card</field>
        <field name="model">mesob.inventory.sub.classification</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="major_classification_id"/>
                <field name="item_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click" type="object" name="action_view_stock_card_details" style="padding: 16px; border-radius: 12px; border: 1px solid #e2e8f0; background: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); margin-bottom: 12px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="font-size: 32px; min-width: 45px; text-align: center;">🧴</div>
                                <div style="flex: 1;">
                                    <div style="font-weight: 700; font-size: 15px; color: #0f172a;">
                                        <field name="name"/>
                                    </div>
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                                        Sub Code: <span style="font-weight: 600;"><field name="code"/></span>
                                    </div>
                                </div>
                                <div style="background: #e0f2fe; padding: 4px 10px; border-radius: 15px; font-size: 11px; font-weight: 600; color: #0369a1; border: 1px solid #bae6fd;">
                                    <field name="item_count"/> items
                                </div>
                            </div>
                            <div style="margin-top: 14px; border-top: 1px dashed #e2e8f0; padding-top: 10px; display: flex; justify-content: flex-end;">
                                <button class="btn btn-primary btn-sm" type="object" name="action_view_stock_card_details" style="font-weight: 600; padding: 4px 12px; font-size: 11px; border-radius: 6px;">
                                    View Stock Card Ledger
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_mesob_sub_classification_form_stock_ledger" model="ir.ui.view">
        <field name="name">mesob.inventory.sub.classification.form.stock.ledger</field>
        <field name="model">mesob.inventory.sub.classification</field>
        <field name="arch" type="xml">
            <form string="Stock Card Details" class="o_mesob_gov_doc">
                <sheet>
                    <div class="mesob_gov_header">
                        <div class="mesob_gov_logo">M</div>
                        <h1 class="mesob_gov_title">Federal Democratic Republic of Ethiopia</h1>
                        <h3 class="mesob_gov_subtitle">Stock Record Card Ledger (Model 19)</h3>
                        <div class="mesob_gov_underline"></div>
                    </div>

                    <group>
                        <group string="Classification Info">
                            <field name="major_classification_id" options="{'no_create': True}" readonly="1"/>
                            <field name="code" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </group>
                        <group string="Status &amp; Statistics">
                            <field name="item_count" string="Total Items Linked" readonly="1"/>
                            <field name="is_fixed_asset" readonly="1"/>
                            <field name="active" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📋 Individual Items" name="items_list" invisible="not is_fixed_asset">
                            <field name="item_ids" readonly="1">
                                <list string="Items">
                                    <field name="name" string="Item Name"/>
                                    <field name="item_code" string="Item Code"/>
                                    <field name="stock_status" widget="badge" 
                                           decoration-danger="stock_status == 'critical'"
                                           decoration-warning="stock_status == 'low'"
                                           decoration-info="stock_status == 'hasten'"
                                           decoration-success="stock_status == 'normal'"/>
                                    <field name="issue_status" widget="badge"
                                           decoration-success="issue_status == 'issued'"
                                           decoration-warning="issue_status == 'not_issued'"/>
                                    <field name="current_holder" string="Current Holder"/>
                                </list>
                            </field>
                        </page>
                        <page string="📈 Stock Record Valuation Ledger" name="stock_record_ledger">
                            <field name="stock_record_ids" readonly="1">
                                <list string="Stock Record Lines" default_order="date asc, id asc">
                                    <field name="date" string="Date"/>
                                    <field name="reference" string="Ref Document"/>
                                    <field name="transaction_type" string="Type" widget="badge"
                                           decoration-info="transaction_type == 'receipt'"
                                           decoration-warning="transaction_type == 'issue'"
                                           decoration-success="transaction_type == 'opening'"/>
                                    
                                    <!-- Received Section -->
                                    <field name="quantity_in" string="Received Qty" sum="Total In"/>
                                    <field name="unit_cost" string="Received Unit Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_cost_in" string="Received Total Price" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Cost In"/>
                                    
                                    <!-- Issued Section -->
                                    <field name="quantity_out" string="Issued Qty" sum="Total Out"/>
                                    <field name="unit_cost_out" string="Issued Unit Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_cost_out" string="Issued Total Price" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Cost Out"/>
                                    
                                    <!-- Balance Section -->
                                    <field name="quantity_balance" string="Balance Qty" decoration-bf="1"/>
                                    <field name="average_cost" string="Balance Unit Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="balance_value" string="Balance Total Price" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1" sum="Total Balance Value"/>
                                    
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mesob_sub_classification_form" model="ir.ui.view">
        <field name="name">mesob.inventory.sub.classification.form</field>
        <field name="model">mesob.inventory.sub.classification</field>
        <field name="arch" type="xml">
            <form string="Sub Classification">
                <sheet>
                    <group>
                        <group string="Classification">
                            <field name="major_classification_id" options="{'no_create': True}"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group string="Status">
                            <field name="is_fixed_asset"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mesob_sub_classification_form_ledger" model="ir.ui.view">
        <field name="name">mesob.inventory.sub.classification.form.ledger</field>
        <field name="model">mesob.inventory.sub.classification</field>
        <field name="arch" type="xml">
            <form string="Sub Classification &amp; Bin Card Details" class="o_mesob_gov_doc">
                <sheet>
                    <div class="mesob_gov_header">
                        <div class="mesob_gov_logo"></div>
                        <h1 class="mesob_gov_title">Federal Democratic Republic of Ethiopia</h1>
                        <h2 class="mesob_gov_org">FDRE Mesob Center</h2>
                        <h3 class="mesob_gov_subtitle">Sub Classification &amp; Bin Card Ledger</h3>
                        <div class="mesob_gov_underline"></div>
                    </div>

                    <group>
                        <group string="Classification Info">
                            <field name="major_classification_id" options="{'no_create': True}" readonly="1"/>
                            <field name="code" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </group>
                        <group string="Status &amp; Statistics">
                            <field name="item_count" string="Total Items Linked" readonly="1"/>
                            <field name="is_fixed_asset" readonly="1"/>
                            <field name="active" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="📋 Individual Items" name="items_list" invisible="not is_fixed_asset">
                            <field name="item_ids" readonly="1">
                                <list string="Items">
                                    <field name="name" string="Item Name"/>
                                    <field name="item_code" string="Item Code"/>
                                    <field name="stock_status" widget="badge" 
                                           decoration-danger="stock_status == 'critical'"
                                           decoration-warning="stock_status == 'low'"
                                           decoration-info="stock_status == 'hasten'"
                                           decoration-success="stock_status == 'normal'"/>
                                    <field name="issue_status" widget="badge"
                                           decoration-success="issue_status == 'issued'"
                                           decoration-warning="issue_status == 'not_issued'"/>
                                    <field name="current_holder" string="Current Holder"/>
                                </list>
                            </field>
                        </page>
                        <page string="📈 Bin Card Transaction Ledger" name="transaction_ledger">
                            <field name="bin_card_ids" readonly="1">
                                <list string="Transactions" default_order="date asc, id asc">
                                    <field name="date" string="Date"/>
                                    <field name="reference" string="Reference"/>
                                    <field name="transaction_type" widget="badge"
                                           decoration-info="transaction_type == 'receipt'"
                                           decoration-warning="transaction_type == 'issue'"
                                           decoration-success="transaction_type == 'adjustment'"/>
                                    <field name="quantity_received" string="Received"/>
                                    <field name="quantity_distributed" string="Issued"/>
                                    <field name="balance" string="Running Balance" decoration-bf="1"/>
                                    <field name="received_by_id" string="Processed By"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mesob_sub_classification_search" model="ir.ui.view">
        <field name="name">mesob.inventory.sub.classification.search</field>
        <field name="model">mesob.inventory.sub.classification</field>
        <field name="arch" type="xml">
            <search string="Sub Classifications">
                <field name="code"/>
                <field name="name"/>
                <field name="major_classification_id"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mesob_sub_classification" model="ir.actions.act_window">
        <field name="name">Sub Classifications</field>
        <field name="res_model">mesob.inventory.sub.classification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a sub classification
            </p>
            <p>
                Sub classifications provide finer categorization under major classifications.
            </p>
        </field>
    </record>

</odoo>
