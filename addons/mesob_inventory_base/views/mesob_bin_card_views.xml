<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Bin Card List View -->
    <record id="view_mesob_bin_card_list" model="ir.ui.view">
        <field name="name">mesob.bin.card.list</field>
        <field name="model">mesob.bin.card</field>
        <field name="arch" type="xml">
            <list string="Bin Cards" create="true" edit="true" delete="true" 
                  default_order="date desc, sub_classification_id"
                  decoration-info="transaction_type == 'transfer'"
                  decoration-warning="transaction_type == 'adjustment'"
                  decoration-success="transaction_type == 'receipt'"
                  decoration-danger="transaction_type == 'issue'">
                <field name="date" class="font-monospace text-muted"/>
                <field name="major_classification_id" class="fw-semibold"/>
                <field name="sub_classification_id" class="fw-semibold text-muted"/>
                <field name="location" class="font-monospace text-primary"/>
                <field name="transaction_type" class="fw-bold"/>
                <field name="reference" class="font-monospace text-muted"/>
                <field name="quantity_received" string="Received" sum="Total Received" class="text-end fw-bold font-monospace text-success"/>
                <field name="quantity_distributed" string="Distributed" sum="Total Distributed" class="text-end fw-bold font-monospace text-danger"/>
                <field name="balance" sum="Total Balance" class="text-end fw-bold font-monospace text-primary"/>
                <field name="item_count" string="Items" optional="show"/>
                <button name="action_view_items" type="object" 
                        string="View Items" 
                        icon="fa-list"
                        title="View detailed items with codes"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ────────────────────────────────────────────── -->
    <record id="view_mesob_bin_card_kanban" model="ir.ui.view">
        <field name="name">mesob.bin.card.kanban</field>
        <field name="model">mesob.bin.card</field>
        <field name="arch" type="xml">
            <kanban default_group_by="transaction_type" drag_drop="false" class="o_kanban_mobile">
                <field name="id"/>
                <field name="location"/>
                <field name="sub_classification_id"/>
                <field name="date"/>
                <field name="transaction_type"/>
                <field name="reference"/>
                <field name="balance"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click card shadow-sm border-0 rounded p-3 mb-3 bg-white" style="min-height: 125px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary text-white font-monospace fs-6 px-2 py-1">
                                    <t t-esc="record.location.value"/>
                                </span>
                                <t t-if="record.transaction_type.raw_value == 'receipt'">
                                    <span class="badge bg-success text-white px-2 py-1 small">
                                        <i class="fa fa-download me-1"/>Receipt
                                    </span>
                                </t>
                                <t t-elif="record.transaction_type.raw_value == 'issue'">
                                    <span class="badge bg-danger text-white px-2 py-1 small">
                                        <i class="fa fa-upload me-1"/>Issue
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">
                                        <i class="fa fa-refresh me-1"/>Adjust/Transfer
                                    </span>
                                </t>
                            </div>
                            <h4 class="o_kanban_record_title fw-bold text-dark fs-5 mb-1 mt-1">
                                <t t-esc="record.sub_classification_id.value"/>
                            </h4>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="text-muted small">
                                    <i class="fa fa-bookmark me-1"/> <t t-esc="record.reference.value or 'No Reference'"/>
                                </span>
                                <span class="text-muted small font-monospace">
                                    <i class="fa fa-calendar me-1"/> <t t-esc="record.date.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Bin Card Form View -->
    <record id="view_mesob_bin_card_form" model="ir.ui.view">
        <field name="name">mesob.bin.card.form</field>
        <field name="model">mesob.bin.card</field>
        <field name="arch" type="xml">
            <form string="Bin Card" class="o_mesob_gov_doc">
                <sheet>
                    <!-- Smart Button -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_items" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="item_count" widget="statinfo" string="Items"/>
                        </button>
                    </div>

                    <!-- Premium Reusable Corporate Form Header -->
                    <div class="mesob_corporate_header">
                        <div class="mesob_header_logo_container">
                            <img src="/mesob_inventory_base/static/img/mesob_logo.png" alt="FDRE Logo"/>
                            <div class="mesob_header_company_name">FDRE Mesob Center</div>
                        </div>
                        <div class="mesob_header_bottom_row">
                            <div class="mesob_header_id">
                                <field name="location" readonly="1"/>
                            </div>
                            <div class="mesob_header_title">Bin Card Ledger</div>
                        </div>
                    </div>
                    
                    <!-- Symmetrical Information: Multi-Column layout w/ No-Clutter Dropdowns -->
                    <group class="mb-4" col="2">
                        <group string="Classification details" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="major_classification_id" options="{'no_open': True, 'no_create': True}" class="mb-3"/>
                            <field name="sub_classification_id" options="{'no_open': True, 'no_create': True}" 
                                   domain="[('major_classification_id', '=', major_classification_id)]" class="mb-3"/>
                        </group>
                        <group string="Transaction details" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="date" class="mb-3 font-monospace"/>
                            <field name="transaction_type" class="mb-3"/>
                            <field name="reference" class="mb-3 font-monospace" placeholder="e.g. IV/2026/0004"/>
                        </group>
                    </group>

                    <group class="mb-4" col="2">
                        <group string="Quantities" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="quantity_received" class="text-end fw-bold font-monospace text-success mb-3"/>
                            <field name="quantity_distributed" class="text-end fw-bold font-monospace text-danger mb-3"/>
                            <field name="balance" class="text-end fw-bold font-monospace text-primary mb-3"/>
                        </group>
                        <group string="Verification signatures" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="received_by_id" options="{'no_open': True, 'no_create': True}" class="mb-3"/>
                            <field name="verified_by_id" options="{'no_open': True, 'no_create': True}" class="mb-3"/>
                        </group>
                    </group>
                    
                    <notebook class="mt-4">
                        <page string="📝 Transaction Description" name="description_tab">
                            <div class="p-3">
                                <label for="description" class="fw-semibold text-muted mb-2 d-block">Ledger Description &amp; Memo Details</label>
                                <field name="description" placeholder="Write any transaction explanations, adjustments reasons, or inventory remarks..." class="w-100 border p-3 rounded" style="min-height: 100px;"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bin Card Hierarchical Navigation Action -->
    <record id="action_mesob_bin_card" model="ir.actions.act_window">
        <field name="name">Bin Cards (Physical Storage Location)</field>
        <field name="res_model">mesob.inventory.major.classification</field>
        <field name="view_mode">kanban,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bin Cards Navigation
            </p>
            <p>
                Select a Major Classification card to browse physical store bins, item balances, and transaction history.
            </p>
        </field>
    </record>

    <!-- Fallback/Raw Transaction Entries Action -->
    <record id="action_mesob_bin_card_raw" model="ir.actions.act_window">
        <field name="name">Raw Bin Card Ledger Entries</field>
        <field name="res_model">mesob.bin.card</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Raw Bin Cards
            </p>
            <p>
                A raw audit log of all transaction lines posted to individual bins.
            </p>
        </field>
    </record>
</odoo>
