<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Bin Card List View -->
    <record id="view_mesob_bin_card_list" model="ir.ui.view">
        <field name="name">mesob.bin.card.list</field>
        <field name="model">mesob.bin.card</field>
        <field name="arch" type="xml">
            <list string="Bin Cards" create="true" edit="true" delete="true" 
                  default_order="date desc, sub_classification_id">
                <field name="date"/>
                <field name="major_classification_id"/>
                <field name="sub_classification_id"/>
                <field name="location"/>
                <field name="transaction_type"/>
                <field name="reference"/>
                <field name="quantity_received" string="Received" sum="Total Received"/>
                <field name="quantity_distributed" string="Distributed" sum="Total Distributed"/>
                <field name="balance" sum="Total Balance"/>
                <field name="item_count" string="Items" optional="show"/>
                <button name="action_view_items" type="object" 
                        string="View Items" 
                        icon="fa-list"
                        title="View detailed items with codes"/>
            </list>
        </field>
    </record>

    <!-- Bin Card Form View -->
    <record id="view_mesob_bin_card_form" model="ir.ui.view">
        <field name="name">mesob.bin.card.form</field>
        <field name="model">mesob.bin.card</field>
        <field name="arch" type="xml">
            <form string="Bin Card" class="o_mesob_gov_doc">
                <sheet>
                    <!-- Smart Button -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_items" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="item_count" widget="statinfo" string="Items"/>
                        </button>
                    </div>

                    <!-- Government Document Header -->
                    <div class="mesob_gov_header">
                        <div class="mesob_gov_logo">M</div>
                        <h1 class="mesob_gov_title">Federal Democratic Republic of Ethiopia</h1>`r`n                        <h2 class="mesob_gov_org">FDRE Mesob Center</h2>
                        <h3 class="mesob_gov_subtitle">Bin Card - Physical Storage Location</h3>
                        <div class="mesob_gov_underline"></div>
                    </div>
                    
                    <group>
                        <group string="Classification">
                            <field name="major_classification_id" options="{'no_create': True}"/>
                            <field name="sub_classification_id" 
                                   domain="[('major_classification_id', '=', major_classification_id)]"
                                   options="{'no_create': True}"/>
                            <field name="location"/>
                        </group>
                        <group string="Transaction Details">
                            <field name="date"/>
                            <field name="transaction_type"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Quantities">
                            <field name="quantity_received"/>
                            <field name="quantity_distributed"/>
                            <field name="balance"/>
                        </group>
                        <group string="Verification">
                            <field name="received_by_id"/>
                            <field name="verified_by_id"/>
                        </group>
                    </group>
                    
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bin Card Hierarchical Navigation Action -->
    <record id="action_mesob_bin_card" model="ir.actions.act_window">
        <field name="name">Bin Cards (Physical Storage Location)</field>
        <field name="res_model">mesob.inventory.major.classification</field>
        <field name="view_mode">kanban,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bin Cards Navigation
            </p>
            <p>
                Select a Major Classification card to browse physical store bins, item balances, and transaction history.
            </p>
        </field>
    </record>

    <!-- Fallback/Raw Transaction Entries Action -->
    <record id="action_mesob_bin_card_raw" model="ir.actions.act_window">
        <field name="name">Raw Bin Card Ledger Entries</field>
        <field name="res_model">mesob.bin.card</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage Raw Bin Cards
            </p>
            <p>
                A raw audit log of all transaction lines posted to individual bins.
            </p>
        </field>
    </record>

</odoo>
