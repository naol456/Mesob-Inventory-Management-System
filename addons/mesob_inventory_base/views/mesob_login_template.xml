<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Customize the login layout to add Mesob branding header -->
    <template id="login_layout_custom" inherit_id="web.login_layout" name="Mesob Login Layout">
        
        <!-- Replace the entire container to add header inside -->
        <xpath expr="//div[@class='container py-5']" position="replace">
            <div class="container py-5">
                <div class="mesob_login_wrapper">
                    <div class="mesob_login_header">
                        <div class="mesob_logo_container">
                            <img src="/mesob_inventory_base/static/img/mesob_logo.png" alt="Mesob Logo" class="mesob_logo"/>
                        </div>
                        <h1 class="mesob_title">Mesob</h1>
                        <p class="mesob_subtitle">Inventory management system</p>
                    </div>
                    <div t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list" style="max-width: 420px !important; width: 420px !important;">
                        <div class="card-body" style="padding: 26px 34px !important;">
                            <!-- Hide database selector field -->
                            <style>
                                .mesob_login_wrapper {
                                    max-width: 420px !important;
                                    width: 100% !important;
                                }
                                .mesob_login_wrapper .o_database_list.card {
                                    max-width: 420px !important;
                                    width: 420px !important;
                                }
                                .o_database_list .form-group:has(select[name="db"]),
                                .o_database_list .form-group:has(input[name="db"]),
                                .oe_login_form .form-group:has(select[name="db"]),
                                .oe_login_form .form-group:has(input[name="db"]),
                                div.field-db,
                                .list-group-item:has(select[name="db"]) {
                                    display: none !important;
                                }
                            </style>
                            <div class="text-center pb-3 border-bottom mb-4" style="display: none;">
                                <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
                            </div>
                            <t t-out="0"/>
                            <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                                <t t-if="not disable_database_manager">
                                    <a class="border-end pe-2 me-1" href="/web/database/manager">Manage Databases</a>
                                </t>
                                <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank">Powered by <span>Odoo</span></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        
    </template>
</odoo>
