<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AUTO-037: Stock Code Catalog Views -->

    <!-- Form View -->
    <record id="mesob_stock_code_catalog_form_view" model="ir.ui.view">
        <field name="name">mesob.stock.code.catalog.form</field>
        <field name="model">mesob.stock.code.catalog</field>
        <field name="arch" type="xml">
            <form string="Stock Code Catalog Version">
                <header>
                    <button name="action_publish_catalog" 
                            type="object" 
                            string="📚 Publish Catalog"
                            invisible="state != 'draft'"
                            class="oe_highlight"
                            confirm="This will publish the catalog and notify all users. Continue?"/>
                    <button name="action_view_catalog_items" 
                            type="object" 
                            string="📖 View Catalog Items"
                            invisible="state != 'published'"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,superseded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="version_name" placeholder="e.g., 2026 Annual Amendment v1.0" required="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="version_info">
                            <field name="version_number" required="1"/>
                            <field name="effective_date" required="1"/>
                        </group>
                        <group name="publication_info">
                            <field name="publication_date" readonly="1"/>
                            <field name="published_by_id" readonly="1"/>
                        </group>
                    </group>
                    
                    <group name="statistics" string="Catalog Statistics" invisible="state == 'draft'">
                        <group>
                            <field name="total_items"/>
                            <field name="new_codes"/>
                        </group>
                        <group>
                            <field name="retired_codes"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Change Log" name="changelog" invisible="state == 'draft'">
                            <field name="change_log" widget="html" readonly="1"/>
                        </page>
                        <page string="Publication Notes" name="notes">
                            <field name="notes" placeholder="Optional notes about this catalog version..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="mesob_stock_code_catalog_tree_view" model="ir.ui.view">
        <field name="name">mesob.stock.code.catalog.list</field>
        <field name="model">mesob.stock.code.catalog</field>
        <field name="arch" type="xml">
            <list string="Stock Code Catalog Versions" 
                  decoration-success="state == 'published'" 
                  decoration-muted="state == 'superseded'">
                <field name="version_name"/>
                <field name="version_number"/>
                <field name="effective_date"/>
                <field name="publication_date"/>
                <field name="total_items"/>
                <field name="new_codes"/>
                <field name="retired_codes"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'published'" 
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'superseded'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="mesob_stock_code_catalog_search_view" model="ir.ui.view">
        <field name="name">mesob.stock.code.catalog.search</field>
        <field name="model">mesob.stock.code.catalog</field>
        <field name="arch" type="xml">
            <search string="Search Stock Code Catalogs">
                <field name="version_name" string="Version Name"/>
                <field name="version_number" string="Version Number"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="filter_superseded" string="Superseded" domain="[('state', '=', 'superseded')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_effective_date" string="Effective Date" context="{'group_by': 'effective_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mesob_stock_code_catalog" model="ir.actions.act_window">
        <field name="name">Stock Code Catalog</field>
        <field name="res_model">mesob.stock.code.catalog</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                📚 AUTO-037: Create Stock Code Catalog Version
            </p>
            <p>
                Maintain live stock code list with version control and change tracking (FR-ID-004, FR-ID-005).
                <ul>
                    <li>Create new catalog versions</li>
                    <li>Track new, modified, and retired codes</li>
                    <li>Auto-generate change logs</li>
                    <li>Notify all users on publication</li>
                    <li>Historical version retention (NFR-QUAL-001)</li>
                </ul>
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_mesob_stock_code_catalog"
              name="Stock Code Catalog"
              parent="menu_mesob_inventory_master_data"
              action="action_mesob_stock_code_catalog"
              sequence="55"/>

</odoo>
