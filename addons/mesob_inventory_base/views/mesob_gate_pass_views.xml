<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Gate Pass Line List View (separate definition) -->
    <record id="view_mesob_gate_pass_line_list" model="ir.ui.view">
        <field name="name">mesob.gate.pass.line.list</field>
        <field name="model">mesob.gate.pass.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" class="glass-table border-0 rounded shadow-sm">
                <field name="item_id" options="{'no_create': True, 'no_open': True}" class="fw-semibold"/>
                <field name="description" placeholder="Item description..."/>
                <field name="quantity" class="text-end fw-bold font-monospace text-primary"/>
                <field name="uom_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="serial_numbers" placeholder="Enter serial numbers..." class="font-monospace text-muted"/>
                <field name="remarks" placeholder="Optional notes..."/>
            </list>
        </field>
    </record>

    <!-- Gate Pass List View -->
    <record id="view_mesob_gate_pass_tree" model="ir.ui.view">
        <field name="name">mesob.gate.pass.list</field>
        <field name="model">mesob.gate.pass</field>
        <field name="arch" type="xml">
            <list string="Gate Passes" 
                  default_order="dispatch_date desc, name desc"
                  decoration-info="state == 'draft'" 
                  decoration-warning="state == 'authorized'" 
                  decoration-success="state == 'dispatched'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" class="fw-bold font-monospace text-primary"/>
                <field name="dispatch_date" class="font-monospace text-muted"/>
                <field name="destination" class="fw-semibold"/>
                <field name="receiver_organization" optional="show" class="fw-semibold text-muted"/>
                <field name="authorized_by_id" class="fw-semibold text-muted"/>
                <field name="security_verified_by_id" optional="show" class="fw-semibold text-muted"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'authorized'"
                       decoration-success="state == 'dispatched'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ────────────────────────────────────────────── -->
    <record id="view_mesob_gate_pass_kanban" model="ir.ui.view">
        <field name="name">mesob.gate.pass.kanban</field>
        <field name="model">mesob.gate.pass</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" drag_drop="false" class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="dispatch_date"/>
                <field name="destination"/>
                <field name="receiver_name"/>
                <field name="vehicle_plate"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click card shadow-sm border-0 rounded p-3 mb-3 bg-white" style="min-height: 125px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary text-white font-monospace fs-6 px-2 py-1">
                                    <t t-esc="record.name.value"/>
                                </span>
                                <t t-if="record.vehicle_plate.raw_value">
                                    <span class="badge bg-success text-white px-2 py-1 small font-monospace">
                                        <i class="fa fa-car me-1"/> <t t-esc="record.vehicle_plate.value"/>
                                    </span>
                                </t>
                            </div>
                            <h4 class="o_kanban_record_title fw-bold text-dark fs-5 mb-1 mt-1">
                                <t t-esc="record.receiver_name.value or 'General Recipient'"/>
                            </h4>
                            <p class="text-muted small mb-0 mt-2">
                                <i class="fa fa-map-marker me-1"/> <t t-esc="record.destination.value or 'No Destination'"/>
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="text-muted small font-monospace">
                                    <i class="fa fa-calendar me-1"/> <t t-esc="record.dispatch_date.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Gate Pass Form View -->
    <record id="view_mesob_gate_pass_form" model="ir.ui.view">
        <field name="name">mesob.gate.pass.form</field>
        <field name="model">mesob.gate.pass</field>
        <field name="arch" type="xml">
            <form string="Gate Pass" class="o_mesob_gov_doc">
                <header>
                    <button name="action_authorize" string="✓ Authorize" type="object" 
                            class="btn-primary" 
                            invisible="state != 'draft'"
                            groups="mesob_inventory_base.group_mesob_pao"/>
                    <button name="action_dispatch" string="✓ Dispatch" type="object" 
                            class="btn-success" 
                            invisible="state != 'authorized'"
                            groups="mesob_inventory_base.group_mesob_security_guard"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state not in ('draft', 'authorized')"/>
                    <button name="action_set_to_draft" string="Reset to Draft" type="object" 
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,authorized,dispatched"/>
                </header>
                <sheet>
                    <!-- Premium Reusable Corporate Form Header -->
                    <div class="mesob_corporate_header">
                        <div class="mesob_header_logo_container">
                            <img src="/mesob_inventory_base/static/img/mesob_logo.png" alt="FDRE Logo"/>
                            <div class="mesob_header_company_name">FDRE Mesob Center</div>
                        </div>
                        <div class="mesob_header_bottom_row">
                            <div class="mesob_header_id">
                                <field name="name" readonly="1"/>
                            </div>
                            <div class="mesob_header_title">Gate Pass (Dispatch)</div>
                        </div>
                    </div>
                    
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_mesob_inventory_issue_voucher)d" type="action"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not issue_voucher_id"
                                context="{'search_default_id': issue_voucher_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Issue Voucher</span>
                            </div>
                        </button>
                    </div>
                    
                    <!-- Symmetrical Information: Multi-Column layout w/ No-Clutter Dropdowns -->
                    <group class="mb-4" col="2">
                        <group string="Authorization details" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="issue_voucher_id" 
                                   options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'" class="mb-3 font-monospace"/>
                            <field name="written_authorization" 
                                   placeholder="e.g. Memo Ref: PAO/2026/045"
                                   readonly="state != 'draft'" class="mb-3"/>
                        </group>
                    </group>

                    <group class="mb-4" col="2">
                        <group string="Receiver details" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="destination" placeholder="e.g. Finance Hub, Branch office..." readonly="state != 'draft'" class="mb-3"/>
                            <field name="receiver_name" placeholder="Full name of receiver..." readonly="state != 'draft'" class="mb-3"/>
                            <field name="receiver_organization" placeholder="Receiver company/department..." readonly="state != 'draft'" class="mb-3"/>
                        </group>
                        <group string="Transport details" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="vehicle_plate" placeholder="e.g. Code 3 - AA 45678" readonly="state != 'draft'" class="mb-3 font-monospace"/>
                            <field name="driver_name" placeholder="Driver's full name..." readonly="state != 'draft'" class="mb-3"/>
                            <field name="driver_license" placeholder="Driver's license number..." readonly="state != 'draft'" class="mb-3 font-monospace"/>
                        </group>
                    </group>

                    <group class="mb-4" col="2">
                        <group string="Dispatch logs" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="dispatch_date" readonly="state != 'draft'" class="mb-3 font-monospace"/>
                            <field name="created_by_id" readonly="1" class="mb-3"/>
                            <field name="authorized_by_id" readonly="1" class="mb-3"/>
                            <field name="authorized_on" readonly="1" class="mb-3 font-monospace"/>
                        </group>
                    </group>
                    
                    <!-- Notebook and sub-tables -->
                    <notebook class="mt-4">
                        <page string="📦 Dispatched Items" name="line_items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" class="glass-table border-0 rounded shadow-sm">
                                    <field name="item_id" options="{'no_create': True, 'no_open': True}" class="fw-semibold"/>
                                    <field name="description" placeholder="Item description..."/>
                                    <field name="quantity" class="text-end fw-bold font-monospace text-primary"/>
                                    <field name="uom_id" options="{'no_create': True, 'no_open': True}" optional="hide"/>
                                    <field name="serial_numbers" placeholder="Enter comma-separated serials..." optional="show" class="font-monospace text-muted"/>
                                    <field name="remarks" placeholder="Optional notes..."/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="📄 Copy Distribution" name="copy_distribution" 
                              invisible="state != 'dispatched'">
                            <group class="p-3" col="2">
                                <group string="Security Verification" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                                    <field name="security_verified_by_id" readonly="1" class="mb-3"/>
                                    <field name="security_verified_on" readonly="1" class="mb-3 font-monospace"/>
                                </group>
                                <group string="Distribution Status" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                                    <field name="original_to_receiver" readonly="1" widget="boolean_toggle" string="✓ Original to Receiver" class="mb-3"/>
                                    <field name="duplicate_to_storekeeper" readonly="1" widget="boolean_toggle" string="✓ Duplicate to Storekeeper" class="mb-3"/>
                                    <field name="triplicate_to_security" readonly="1" widget="boolean_toggle" string="✓ Triplicate to Security" class="mb-3"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="📝 Notes" name="notes">
                            <div class="p-3">
                                <label for="note" class="fw-semibold text-muted mb-2 d-block">Transit Comments &amp; Security Remarks</label>
                                <field name="note" placeholder="Write any specific security checks, gate-entry clearance notes, or transport remarks..." nolabel="1" class="w-100 border p-3 rounded" style="min-height: 100px;"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Native Odoo Social Chatter Feed (Sleek Bottom Sidebar) -->
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Gate Pass Action -->
    <record id="action_mesob_gate_pass_v2" model="ir.actions.act_window">
        <field name="name">Gate Passes</field>
        <field name="res_model">mesob.gate.pass</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Gate Pass
            </p>
            <p>
                Gate Passes authorize material dispatch outside the compound.
                All Gate Passes require PAO authorization before dispatch.
            </p>
        </field>
    </record>

    <!-- Pending Authorization Action (PAO View) -->
    <record id="action_mesob_gate_pass_pending_authorization_v2" model="ir.actions.act_window">
        <field name="name">Pending Authorization</field>
        <field name="res_model">mesob.gate.pass</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Gate Passes pending authorization
            </p>
            <p>
                Gate Passes in draft state will appear here for PAO authorization.
            </p>
        </field>
    </record>

    <!-- Pending Dispatch Action (Security Guard View) -->
    <record id="action_mesob_gate_pass_pending_dispatch_v2" model="ir.actions.act_window">
        <field name="name">Pending Dispatch</field>
        <field name="res_model">mesob.gate.pass</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '=', 'authorized')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Gate Passes pending dispatch
            </p>
            <p>
                Authorized Gate Passes will appear here for security gate verification and dispatch.
            </p>
        </field>
    </record>

</odoo>
