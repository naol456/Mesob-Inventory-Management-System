<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- KANBAN VIEW -->
    <record id="view_mesob_asset_dashboard_kanban" model="ir.ui.view">
        <field name="name">mesob.asset.dashboard.kanban</field>
        <field name="model">mesob.asset.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="mesob_asset_dashboard_kanban">
                <field name="item_code"/>
                <field name="item_name"/>
                <field name="asset_state"/>
                <field name="holder_image"/>
                <field name="holder_name"/>
                <field name="using_department_id"/>
                <field name="current_location"/>
                <field name="quantity_total"/>
                <field name="quantity_issued"/>
                <field name="is_surplus"/>
                
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image me-1">
                                <img t-att-src="kanban_image('res.users', 'image_128', record.current_holder_id.raw_value)" 
                                     alt="Holder" class="o_image_64_contain" 
                                     t-if="record.current_holder_id.raw_value"/>
                                <span t-else="" class="fa fa-cube fa-3x text-muted"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="item_code"/> - <field name="item_name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="using_department_id"/>
                                </div>
                                <div>
                                    <span class="badge" t-attf-class="badge-{{record.asset_state.raw_value}}">
                                        <field name="asset_state"/>
                                    </span>
                                </div>
                                <div t-if="record.holder_name.raw_value">
                                    <i class="fa fa-user"/> <field name="holder_name"/>
                                </div>
                                <div>
                                    <i class="fa fa-map-marker"/> <field name="current_location"/>
                                </div>
                                <div>
                                    <strong>Qty:</strong> <field name="quantity_total"/> 
                                    (<field name="quantity_issued"/> issued)
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- LIST VIEW -->
    <record id="view_mesob_asset_dashboard_tree" model="ir.ui.view">
        <field name="name">mesob.asset.dashboard.tree</field>
        <field name="model">mesob.asset.dashboard</field>
        <field name="arch" type="xml">
            <list string="Asset Register" class="mesob_asset_dashboard_list">
                <field name="item_code"/>
                <field name="item_name"/>
                <field name="asset_state" widget="badge"/>
                <field name="holder_name"/>
                <field name="using_department_id"/>
                <field name="current_location"/>
                <field name="quantity_total"/>
                <field name="quantity_issued"/>
                <field name="total_value"/>
                <field name="owning_branch"/>
            </list>
        </field>
    </record>
    
    <!-- FORM VIEW -->
    <record id="view_mesob_asset_dashboard_form" model="ir.ui.view">
        <field name="name">mesob.asset.dashboard.form</field>
        <field name="model">mesob.asset.dashboard</field>
        <field name="arch" type="xml">
            <form string="Asset Details" class="mesob_asset_dashboard_form">
                <header>
                    <button name="action_view_history" type="object" string="View History" 
                            icon="fa-history" class="btn-primary"/>
                    <field name="asset_state" widget="statusbar" 
                           statusbar_visible="in_stock,issued,idle,missing"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" 
                                name="action_view_history" icon="fa-history">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="issue_count"/></span>
                                <span class="o_stat_text">Times Issued</span>
                            </div>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Surplus" 
                            bg_color="bg-warning" invisible="not is_surplus"/>
                    <widget name="web_ribbon" title="Controlled" 
                            bg_color="bg-danger" invisible="not is_controlled"/>
                    
                    <field name="holder_image" widget="image" class="oe_avatar"/>
                    
                    <div class="oe_title">
                        <label for="item_id" class="oe_edit_only"/>
                        <h1><field name="item_id" placeholder="Select Inventory Item..." 
                                   options="{'no_create': True}"/></h1>
                        <h2><field name="item_code" readonly="1" class="text-muted"/></h2>
                        <h3><field name="item_name" readonly="1"/></h3>
                    </div>
                    
                    <div class="mesob_form_divider"/>
                    
                    <group>
                        <group string="Current Holder">
                            <field name="current_holder_id" widget="many2one_avatar_user"/>
                            <field name="holder_name"/>
                            <field name="holder_email" widget="email"/>
                            <field name="holder_phone" widget="phone"/>
                            <field name="using_department_id"/>
                        </group>
                        <group string="Location and Ownership">
                            <field name="current_location"/>
                            <field name="owning_branch"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Classification">
                            <field name="major_classification_id"/>
                            <field name="sub_classification_id"/>
                            <field name="is_controlled"/>
                            <field name="is_surplus"/>
                        </group>
                        <group string="Quantities">
                            <field name="quantity_total" class="text-success"/>
                            <field name="quantity_in_stock"/>
                            <field name="quantity_issued" class="text-warning"/>
                            <field name="quantity_available" class="text-primary"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Financial (FIFO)">
                            <field name="currency_id" invisible="1"/>
                            <field name="unit_cost" widget="monetary"/>
                            <field name="total_value" widget="monetary" class="text-success"/>
                        </group>
                        <group string="Lifecycle">
                            <field name="first_received_date"/>
                            <field name="last_movement_date"/>
                            <field name="days_since_last_movement" 
                                   decoration-danger="days_since_last_movement &gt; 180"
                                   decoration-warning="days_since_last_movement &gt; 90"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Asset description and notes..."/>
                            <field name="item_name_am"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ACTION -->
    <record id="action_mesob_asset_dashboard" model="ir.actions.act_window">
        <field name="name">Asset Register</field>
        <field name="res_model">mesob.asset.dashboard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Asset Register
            </p>
            <p>
                Click "Sync From Items" to populate the register with your existing inventory items.
            </p>
        </field>
    </record>
    
    <!-- SYNC BUTTON ACTION -->
    <record id="action_sync_asset_register" model="ir.actions.server">
        <field name="name">Sync From Items</field>
        <field name="model_id" ref="model_mesob_asset_dashboard"/>
        <field name="binding_model_id" ref="model_mesob_asset_dashboard"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = model.action_sync_from_items()
        </field>
    </record>
    
    <!-- MENU ITEM -->
    <menuitem id="menu_mesob_asset_dashboard"
              name="Asset Register"
              parent="menu_mesob_inventory_stock_control"
              action="action_mesob_asset_dashboard"
              sequence="5"/>
    
</odoo>
