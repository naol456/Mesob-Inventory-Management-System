<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════
         Stock Taking Sheet Views (SRS 4.8)
         ══════════════════════════════════════════════════════════════ -->

    <!-- Form View: Stock Taking Sheet -->
    <record id="view_mesob_stock_taking_sheet_form" model="ir.ui.view">
        <field name="name">mesob.stock.taking.sheet.form</field>
        <field name="model">mesob.inventory.stock.taking.sheet</field>
        <field name="arch" type="xml">
            <form string="Stock Taking Sheet">
                <header>
                    <button name="action_issue" string="Issue Sheet" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" string="Return Sheet" type="object" 
                            class="btn-warning" invisible="state != 'issued'"/>
                    <button name="action_verify" string="Verify Sheet" type="object" 
                            class="btn-success" invisible="state != 'returned'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            invisible="state in ['draft', 'verified']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,issued,returned,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="location_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="issued_to_id" readonly="state != 'draft'"/>
                            <field name="issued_date" readonly="1"/>
                            <field name="returned_date" readonly="1"/>
                            <field name="verified_by_id" readonly="1"/>
                            <field name="verified_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="line_count"/>
                            <field name="counted_line_count"/>
                        </group>
                        <group>
                            <field name="discrepancy_line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items to Count" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" 
                                      decoration-success="is_counted and not has_discrepancy"
                                      decoration-warning="is_counted and has_discrepancy and discrepancy_type == 'shortage'"
                                      decoration-danger="is_counted and has_discrepancy and discrepancy_type == 'overage'">
                                    <field name="item_code"/>
                                    <field name="item_name"/>
                                    <field name="classification_code"/>
                                    <field name="expected_quantity"/>
                                    <field name="counted_quantity" readonly="parent.state not in ['issued', 'returned']"/>
                                    <field name="discrepancy_quantity" readonly="1"/>
                                    <field name="discrepancy_percentage" readonly="1" optional="hide"/>
                                    <field name="is_counted" widget="boolean_toggle"/>
                                    <field name="counted_by_id" readonly="1" optional="hide"/>
                                    <field name="has_discrepancy" column_invisible="1"/>
                                    <field name="discrepancy_type" column_invisible="1"/>
                                    <field name="uom_id"/>
                                    <field name="sheet_id" column_invisible="1"/>
                                    <field name="location_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Discrepancies" name="discrepancies" invisible="discrepancy_line_count == 0">
                            <field name="line_ids" domain="[('has_discrepancy', '=', True)]">
                                <list editable="bottom"
                                      decoration-warning="discrepancy_type == 'shortage'"
                                      decoration-danger="discrepancy_type == 'overage'">
                                    <field name="item_code"/>
                                    <field name="item_name"/>
                                    <field name="expected_quantity"/>
                                    <field name="counted_quantity"/>
                                    <field name="discrepancy_quantity"/>
                                    <field name="discrepancy_percentage"/>
                                    <field name="discrepancy_type" widget="badge"/>
                                    <field name="discrepancy_reason"/>
                                    <field name="reason_notes"/>
                                    <field name="corrective_action"/>
                                    <field name="action_responsible_id"/>
                                    <field name="action_deadline"/>
                                    <field name="action_completed" widget="boolean_toggle"/>
                                    <field name="has_discrepancy" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View: Stock Taking Sheet -->
    <record id="view_mesob_stock_taking_sheet_list" model="ir.ui.view">
        <field name="name">mesob.stock.taking.sheet.list</field>
        <field name="model">mesob.inventory.stock.taking.sheet</field>
        <field name="arch" type="xml">
            <list string="Stock Taking Sheets" class="mesob_stock_taking_sheet_list">
                <field name="name"/>
                <field name="event_id"/>
                <field name="location_id"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'issued'"
                       decoration-primary="state == 'returned'"
                       decoration-success="state == 'verified'"/>
                <field name="issued_to_id"/>
                <field name="line_count"/>
                <field name="counted_line_count"/>
                <field name="discrepancy_line_count"/>
            </list>
        </field>
    </record>

    <!-- Kanban View: Stock Taking Sheet -->
    <record id="view_mesob_stock_taking_sheet_kanban" model="ir.ui.view">
        <field name="name">mesob.stock.taking.sheet.kanban</field>
        <field name="model">mesob.inventory.stock.taking.sheet</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="event_id"/>
                <field name="location_id"/>
                <field name="state"/>
                <field name="issued_to_id"/>
                <field name="line_count"/>
                <field name="counted_line_count"/>
                <field name="discrepancy_line_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="location_id"/>
                                    </div>
                                </div>
                                <field name="state" widget="label_selection" 
                                       options="{'classes': {'draft': 'info', 'issued': 'warning', 'returned': 'primary', 'verified': 'success'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Event: <field name="event_id"/></div>
                                <div t-if="record.issued_to_id.raw_value">Issued to: <field name="issued_to_id"/></div>
                                <div>Lines: <field name="counted_line_count"/>/<field name="line_count"/></div>
                                <div t-if="record.discrepancy_line_count.raw_value > 0" class="text-danger">
                                    Discrepancies: <field name="discrepancy_line_count"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View: Stock Taking Sheet -->
    <record id="view_mesob_stock_taking_sheet_search" model="ir.ui.view">
        <field name="name">mesob.stock.taking.sheet.search</field>
        <field name="model">mesob.inventory.stock.taking.sheet</field>
        <field name="arch" type="xml">
            <search string="Search Stock Taking Sheets">
                <field name="name"/>
                <field name="event_id"/>
                <field name="location_id"/>
                <field name="issued_to_id"/>
                
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Issued" name="filter_issued" domain="[('state', '=', 'issued')]"/>
                <filter string="Returned" name="filter_returned" domain="[('state', '=', 'returned')]"/>
                <filter string="Verified" name="filter_verified" domain="[('state', '=', 'verified')]"/>
                
                <separator/>
                <filter string="Has Discrepancies" name="filter_has_discrepancies" 
                        domain="[('discrepancy_line_count', '>', 0)]"/>
                <filter string="My Sheets" name="filter_my_sheets" 
                        domain="[('issued_to_id', '=', uid)]"/>
                
                <group>
                    <filter string="Event" name="group_event" context="{'group_by': 'event_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Issued To" name="group_issued_to" context="{'group_by': 'issued_to_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Stock Taking Sheet -->
    <record id="action_mesob_stock_taking_sheet" model="ir.actions.act_window">
        <field name="name">Stock Taking Sheets</field>
        <field name="res_model">mesob.inventory.stock.taking.sheet</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_issued': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Stock Taking Sheets
            </p>
            <p>
                Stock taking sheets are generated from stock taking events.
                Each sheet contains items to count in a specific location.
            </p>
        </field>
    </record>

</odoo>
