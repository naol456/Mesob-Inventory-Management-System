<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ── List View ──────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_requisition_list" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.list</field>
        <field name="model">mesob.inventory.requisition</field>
        <field name="arch" type="xml">
            <list string="Stores Requisitions" default_order="requested_on desc"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" class="fw-bold font-monospace text-primary"/>
                <field name="issue_mode" class="fw-semibold"/>
                <field name="department" optional="show"/>
                <field name="requested_by_id" class="fw-semibold text-muted"/>
                <field name="requested_on" class="font-monospace text-muted"/>
                <field name="approved_by_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_requisition_kanban" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.kanban</field>
        <field name="model">mesob.inventory.requisition</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" drag_drop="false" class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="requested_by_id"/>
                <field name="requested_on"/>
                <field name="department"/>
                <field name="issue_mode"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click card shadow-sm border-0 rounded p-3 mb-3 bg-white" style="min-height: 120px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary text-white font-monospace fs-6 px-2 py-1">
                                    <t t-esc="record.name.value"/>
                                </span>
                                <t t-if="record.issue_mode.raw_value == 'loan'">
                                    <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">
                                        <i class="fa fa-refresh me-1"/>Loan
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="badge bg-secondary text-white px-2 py-1 small">
                                        <i class="fa fa-gift me-1"/>Permanent
                                    </span>
                                </t>
                            </div>
                            <h4 class="o_kanban_record_title fw-bold text-dark fs-5 mb-1 mt-1">
                                <t t-esc="record.department.value or 'General Department'"/>
                            </h4>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="text-muted small">
                                    <i class="fa fa-user-circle me-1"/> <t t-esc="record.requested_by_id.value"/>
                                </span>
                                <span class="text-muted small font-monospace">
                                    <i class="fa fa-calendar me-1"/> <t t-esc="record.requested_on.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────── -->
    <!-- Form view for Inventory Users - CAN create -->
    <record id="view_mesob_inventory_requisition_form" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.form</field>
        <field name="model">mesob.inventory.requisition</field>
        <field name="arch" type="xml">
            <form string="Stores Requisition (Model 20)">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="mesob_inventory_base.group_mesob_inventory_user"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="mesob_inventory_base.group_mesob_pao"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="mesob_inventory_base.group_mesob_pao"/>
                    <button name="action_create_issue_voucher" type="object" string="Create Issue Voucher"
                            class="btn-primary"
                            invisible="state != 'approved'"
                            groups="mesob_inventory_base.group_mesob_storekeeper"/>
                    <button name="action_set_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"
                            groups="mesob_inventory_base.group_mesob_inventory_user"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'approved', 'issued', 'received')"
                            groups="mesob_inventory_base.group_mesob_inventory_user"
                            confirm="Are you sure you want to cancel this requisition?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,issued,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_issue_vouchers" type="object" 
                                class="oe_stat_button" icon="fa-file-text-o" 
                                invisible="issue_voucher_count == 0"
                                groups="mesob_inventory_base.group_mesob_storekeeper">
                            <field name="issue_voucher_count" widget="statinfo" 
                                   string="Issue Vouchers"/>
                        </button>
                    </div>
                    
                    <!-- Premium Corporate Form Header: Centered Letterhead with Symmetrical Split -->
                    <div class="mesob_corporate_header">
                        <!-- Top Center: Logo & Company Name -->
                        <div class="mesob_header_logo_container">
                            <img src="/mesob_inventory_base/static/img/mesob_logo.png" alt="FDRE Logo"/>
                            <div class="mesob_header_company_name">FDRE Mesob Center</div>
                        </div>
                        
                        <!-- Bottom Row: Symmetrical Split (Left: Form ID, Right: Form Name) -->
                        <div class="mesob_header_bottom_row">
                            <!-- Left Bottom: Form ID -->
                            <div class="mesob_header_id">
                                <field name="name" readonly="1"/>
                            </div>
                            <!-- Right Bottom: Form Name -->
                            <div class="mesob_header_title">Requisition (Model 20)</div>
                        </div>
                    </div>

                    <!-- Primary Creation Fields: Symmetrical 2-Column Grid -->
                    <group class="mb-4" col="2">
                        <group string="Requisition Information" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="issue_mode" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'" class="mb-3"/>
                            <field name="department" placeholder="e.g. IT Department, Finance, Logistics..." readonly="state != 'draft'" class="mb-3"/>
                            <field name="requested_by_id" 
                                   readonly="1"
                                   options="{'no_open': True, 'no_create': True}" 
                                   class="mb-3"/>
                            <field name="requested_on" readonly="state != 'draft'" class="mb-3"/>

                            <!-- Dynamic Informational Tip Helper -->
                            <div class="mt-2 text-muted small border-top pt-2 w-100" colspan="2" style="font-size: 0.9em; opacity: 0.85;">
                                <i class="fa fa-info-circle me-1 text-primary" title="Info"/> 
                                <span invisible="issue_mode != 'imprest'"><strong>Imprest Basis:</strong> Periodic top-up to maintain your department's standard cabinet stock (e.g. paper, pens).</span>
                                <span invisible="issue_mode != 'replacement'"><strong>Replacement Issue:</strong> Requisition a new item by returning a consumed or broken item (e.g. empty ink cartridge, dead bulb).</span>
                                <span invisible="issue_mode != 'non_stock'"><strong>Non-Stock Issue:</strong> A one-time, special requisition for items not regularly stocked.</span>
                            </div>
                        </group>
                    </group>

                    <!-- Approvals Audit Card: Separated and Dynamically Displayed Direct Below Primary Card -->
                    <group class="mb-4" invisible="state not in ('approved', 'rejected')">
                        <group string="Approval &amp; Audit Logs" col="2" class="glass-card p-4 rounded shadow-sm border w-100">
                            <field name="approved_by_id" readonly="True" class="mb-3"/>
                            <field name="approved_on" readonly="True" class="mb-3"/>
                            <field name="rejection_reason" invisible="state != 'rejected'" readonly="True" class="mb-3 text-danger fw-semibold" colspan="2"/>
                        </group>
                    </group>

                    <notebook class="mt-4">
                        <page string="Requisition Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" class="glass-table border-0 rounded shadow-sm">
                                    <field name="major_classification_id" class="fw-semibold" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="sub_classification_id" 
                                           domain="[('major_classification_id', '=', major_classification_id), ('active', '=', True)]"
                                           class="fw-semibold text-muted"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="quantity" class="text-end fw-bold font-monospace text-primary" style="font-size: 1.1em;" placeholder="Quantity..."/>
                                    <field name="note" placeholder="E.g. requested specifications, brand, size..."/>
                                </list>
                            </field>
                        </page>
                        <page string="Additional Notes" name="notes">
                            <div class="p-3">
                                <label for="note" class="fw-semibold text-muted mb-2 d-block">Internal Comments / Special Instructions</label>
                                <field name="note" placeholder="Add any storage logistics notes, courier details, or special administrative remarks..." class="w-100 border p-3 rounded" style="min-height: 100px;"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_requisition_search" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.search</field>
        <field name="model">mesob.inventory.requisition</field>
        <field name="arch" type="xml">
            <search string="Stores Requisitions">
                <field name="name"/>
                <field name="requested_by_id"/>
                <field name="department"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter string="My Requisitions" name="filter_mine"
                        domain="[('requested_by_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <!-- ── Actions ─────────────────────────────────────────────────── -->
    <record id="action_mesob_inventory_requisition" model="ir.actions.act_window">
        <field name="name">Stores Requisitions</field>
        <field name="res_model">mesob.inventory.requisition</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a stores requisition (Model 20)
            </p>
            <p>
                Requisitions must be approved by the Property Administration
                Officer (PAO) before items can be issued from store.
            </p>
        </field>
    </record>
</odoo>
