<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ── List View ──────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_requisition_list" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.list</field>
        <field name="model">mesob.inventory.requisition</field>
        <field name="arch" type="xml">
            <list string="Stores Requisitions" default_order="requested_on desc"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="issue_mode"/>
                <field name="department" optional="show"/>
                <field name="requested_by_id"/>
                <field name="requested_on"/>
                <field name="approved_by_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_requisition_form" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.form</field>
        <field name="model">mesob.inventory.requisition</field>
        <field name="arch" type="xml">
            <form string="Stores Requisition (Model 20)">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="mesob_inventory_base.group_mesob_inventory_user"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="mesob_inventory_base.group_mesob_pao"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="mesob_inventory_base.group_mesob_pao"/>
                    <button name="action_create_issue_voucher" type="object" string="Create Issue Voucher"
                            class="btn-primary"
                            invisible="state != 'approved'"
                            groups="mesob_inventory_base.group_mesob_storekeeper,mesob_inventory_base.group_mesob_pao"/>
                    <button name="action_set_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"
                            groups="mesob_inventory_base.group_mesob_inventory_user"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'approved', 'issued', 'received')"
                            groups="mesob_inventory_base.group_mesob_inventory_user"
                            confirm="Are you sure you want to cancel this requisition?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,issued,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_issue_vouchers" type="object" 
                                class="oe_stat_button" icon="fa-file-text-o" 
                                invisible="issue_voucher_count == 0">
                            <field name="issue_voucher_count" widget="statinfo" 
                                   string="Issue Vouchers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Request Details">
                            <field name="issue_mode"
                                   readonly="state != 'draft'"/>
                            <field name="department"
                                   readonly="state != 'draft'"/>
                            <field name="requested_by_id"
                                   readonly="state != 'draft'"/>
                            <field name="requested_on"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Approval"
                               invisible="state not in ('approved', 'rejected')">
                            <field name="approved_by_id"/>
                            <field name="approved_on"/>
                            <field name="rejection_reason"
                                   invisible="state != 'rejected'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Requisition Lines" name="lines">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="item_id"/>
                                    <field name="quantity"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────── -->
    <record id="view_mesob_inventory_requisition_search" model="ir.ui.view">
        <field name="name">mesob.inventory.requisition.search</field>
        <field name="model">mesob.inventory.requisition</field>
        <field name="arch" type="xml">
            <search string="Stores Requisitions">
                <field name="name"/>
                <field name="requested_by_id"/>
                <field name="department"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter string="My Requisitions" name="filter_mine"
                        domain="[('requested_by_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────── -->
    <record id="action_mesob_inventory_requisition" model="ir.actions.act_window">
        <field name="name">Stores Requisitions</field>
        <field name="res_model">mesob.inventory.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a stores requisition (Model 20)
            </p>
            <p>
                Requisitions must be approved by the Property Administration
                Officer (PAO) before items can be issued from store.
            </p>
        </field>
    </record>
</odoo>
