<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== AUTO-015: DOMESTIC PREFERENCE CALCULATION ==================== -->
    <record id="view_mesob_domestic_preference_calc_tree" model="ir.ui.view">
        <field name="name">mesob.domestic.preference.calculation.tree</field>
        <field name="model">mesob.domestic.preference.calculation</field>
        <field name="arch" type="xml">
            <list string="Domestic Preference Calculations">
                <field name="name"/>
                <field name="tender_ref"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mesob_domestic_preference_calc_form" model="ir.ui.view">
        <field name="name">mesob.domestic.preference.calculation.form</field>
        <field name="model">mesob.domestic.preference.calculation</field>
        <field name="arch" type="xml">
            <form string="Domestic Preference Calculation">
                <header>
                    <button name="action_calculate" string="Calculate" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_validate" string="Validate" type="object" 
                            class="oe_highlight" invisible="state != 'calculated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,validated"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tender_ref"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="total_bidders"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bidders" name="bidders">
                            <field name="calculation_line_ids">
                                <list editable="bottom">
                                    <field name="bidder_id"/>
                                    <field name="bidder_name"/>
                                    <field name="bid_price"/>
                                    <field name="local_content_percentage"/>
                                    <field name="preference_percentage"/>
                                    <field name="evaluated_price"/>
                                    <field name="rank"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mesob_domestic_preference_calculation" model="ir.actions.act_window">
        <field name="name">Domestic Preference Calculator</field>
        <field name="res_model">mesob.domestic.preference.calculation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== AUTO-030: LIQUIDATED DAMAGES CALCULATION ==================== -->
    <record id="view_mesob_liquidated_damages_calc_tree" model="ir.ui.view">
        <field name="name">mesob.liquidated.damages.calculation.tree</field>
        <field name="model">mesob.liquidated.damages.calculation</field>
        <field name="arch" type="xml">
            <list string="Liquidated Damages">
                <field name="name"/>
                <field name="contract_ref"/>
                <field name="supplier_id"/>
                <field name="delay_days"/>
                <field name="ld_capped_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mesob_liquidated_damages_calc_form" model="ir.ui.view">
        <field name="name">mesob.liquidated.damages.calculation.form</field>
        <field name="model">mesob.liquidated.damages.calculation</field>
        <field name="arch" type="xml">
            <form string="Liquidated Damages">
                <header>
                    <button name="action_calculate" string="Calculate" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" 
                            class="oe_highlight" invisible="state != 'calculated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,approved,deducted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contract_ref"/>
                            <field name="supplier_id"/>
                            <field name="contract_value"/>
                        </group>
                        <group>
                            <field name="contract_delivery_date"/>
                            <field name="actual_delivery_date"/>
                            <field name="delay_days"/>
                            <field name="ld_capped_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mesob_liquidated_damages_calculation" model="ir.actions.act_window">
        <field name="name">Liquidated Damages Calculator</field>
        <field name="res_model">mesob.liquidated.damages.calculation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== AUTO-031: PRICE ADJUSTMENT CALCULATION ==================== -->
    <record id="view_mesob_price_adjustment_calc_tree" model="ir.ui.view">
        <field name="name">mesob.price.adjustment.calculation.tree</field>
        <field name="model">mesob.price.adjustment.calculation</field>
        <field name="arch" type="xml">
            <list string="Price Adjustments">
                <field name="name"/>
                <field name="contract_ref"/>
                <field name="supplier_id"/>
                <field name="adjustment_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mesob_price_adjustment_calc_form" model="ir.ui.view">
        <field name="name">mesob.price.adjustment.calculation.form</field>
        <field name="model">mesob.price.adjustment.calculation</field>
        <field name="arch" type="xml">
            <form string="Price Adjustment">
                <header>
                    <button name="action_calculate" string="Calculate" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" 
                            class="oe_highlight" invisible="state != 'calculated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,approved,applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contract_ref"/>
                            <field name="supplier_id"/>
                            <field name="base_contract_value"/>
                        </group>
                        <group>
                            <field name="adjusted_contract_value"/>
                            <field name="adjustment_amount"/>
                            <field name="adjustment_percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Indices" name="indices">
                            <group>
                                <group string="Labor">
                                    <field name="labor_weight"/>
                                    <field name="base_labor_index"/>
                                    <field name="current_labor_index"/>
                                </group>
                                <group string="Material">
                                    <field name="material_weight"/>
                                    <field name="base_material_index"/>
                                    <field name="current_material_index"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mesob_price_adjustment_calculation" model="ir.actions.act_window">
        <field name="name">Price Adjustment Calculator</field>
        <field name="res_model">mesob.price.adjustment.calculation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== AUTO-035: PROCUREMENT-STOCK RECONCILIATION ==================== -->
    <record id="view_mesob_procurement_stock_reconciliation_tree" model="ir.ui.view">
        <field name="name">mesob.procurement.stock.reconciliation.tree</field>
        <field name="model">mesob.procurement.stock.reconciliation</field>
        <field name="arch" type="xml">
            <list string="Procurement-Stock Reconciliation Reports">
                <field name="name"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="reconciliation_rate"/>
                <field name="total_discrepancies"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mesob_procurement_stock_reconciliation_form" model="ir.ui.view">
        <field name="name">mesob.procurement.stock.reconciliation.form</field>
        <field name="model">mesob.procurement.stock.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Procurement-Stock Reconciliation">
                <header>
                    <button name="action_generate_report" string="Generate Report" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pao_review" string="PAO Review" type="object" 
                            class="oe_highlight" invisible="state != 'generated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,reviewed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="report_date"/>
                        </group>
                        <group>
                            <field name="period_from"/>
                            <field name="period_to"/>
                        </group>
                    </group>
                    <group string="Filters">
                        <group>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="classification_id"/>
                        </group>
                    </group>
                    <group string="Summary Statistics">
                        <group>
                            <field name="total_pos"/>
                            <field name="total_reconciled"/>
                            <field name="total_discrepancies"/>
                        </group>
                        <group>
                            <field name="reconciliation_rate"/>
                            <field name="quantity_gap_count"/>
                            <field name="cost_gap_count"/>
                            <field name="payment_gap_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report" name="report">
                            <field name="reconciliation_report" widget="html"/>
                        </page>
                        <page string="Reconciliation Lines" name="lines">
                            <field name="reconciliation_line_ids">
                                <list>
                                    <field name="po_reference"/>
                                    <field name="item_code"/>
                                    <field name="item_name"/>
                                    <field name="po_quantity"/>
                                    <field name="model19_quantity"/>
                                    <field name="stock_record_quantity"/>
                                    <field name="payment_quantity"/>
                                    <field name="is_fully_reconciled"/>
                                    <field name="has_quantity_gap"/>
                                    <field name="has_cost_gap"/>
                                    <field name="has_payment_gap"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mesob_procurement_stock_reconciliation" model="ir.actions.act_window">
        <field name="name">Procurement-Stock Reconciliation</field>
        <field name="res_model">mesob.procurement.stock.reconciliation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== AUTO-055: STOCK ACCURACY SCORECARD ==================== -->
    <record id="view_mesob_stock_accuracy_scorecard_tree" model="ir.ui.view">
        <field name="name">mesob.stock.accuracy.scorecard.tree</field>
        <field name="model">mesob.stock.accuracy.scorecard</field>
        <field name="arch" type="xml">
            <list string="Stock Accuracy Scorecards">
                <field name="name"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <field name="accuracy_score"/>
                <field name="accuracy_rating"/>
                <field name="trend_direction"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mesob_stock_accuracy_scorecard_form" model="ir.ui.view">
        <field name="name">mesob.stock.accuracy.scorecard.form</field>
        <field name="model">mesob.stock.accuracy.scorecard</field>
        <field name="arch" type="xml">
            <form string="Stock Accuracy Scorecard">
                <header>
                    <button name="action_calculate_scorecard" string="Calculate Scorecard" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pao_review" string="PAO Review" type="object" 
                            class="oe_highlight" invisible="state != 'calculated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,reviewed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="scorecard_date"/>
                        </group>
                        <group>
                            <field name="period_month"/>
                            <field name="period_year"/>
                        </group>
                    </group>
                    <group string="Filters">
                        <group>
                            <field name="classification_id"/>
                        </group>
                        <group>
                            <field name="location"/>
                        </group>
                    </group>
                    <group string="Accuracy Metrics">
                        <group>
                            <field name="total_items_counted"/>
                            <field name="items_accurate"/>
                            <field name="items_with_variance"/>
                        </group>
                        <group>
                            <field name="accuracy_score"/>
                            <field name="accuracy_rating"/>
                            <field name="total_variance_value"/>
                        </group>
                    </group>
                    <group string="Trend Analysis">
                        <group>
                            <field name="previous_month_score"/>
                            <field name="trend_change"/>
                        </group>
                        <group>
                            <field name="trend_direction"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scorecard Report" name="report">
                            <field name="scorecard_report" widget="html"/>
                        </page>
                        <page string="Accuracy Lines" name="lines">
                            <field name="accuracy_line_ids">
                                <list>
                                    <field name="item_code"/>
                                    <field name="item_name"/>
                                    <field name="system_quantity"/>
                                    <field name="physical_quantity"/>
                                    <field name="variance_quantity"/>
                                    <field name="variance_percentage"/>
                                    <field name="variance_value"/>
                                    <field name="is_accurate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mesob_stock_accuracy_scorecard" model="ir.actions.act_window">
        <field name="name">Stock Accuracy Scorecard</field>
        <field name="res_model">mesob.stock.accuracy.scorecard</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
